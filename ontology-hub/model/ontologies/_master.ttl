@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://cldn.com/ont/master> a owl:Ontology ;
    rdfs:label "CLdN Master Ontology"@en ;
    rdfs:comment "Unified ontology that imports all domain ontologies for CLdN Logistics."@en ;
    owl:versionInfo "0.5.0" ;
    owl:imports <https://cldn.com/ont/party> ,
               <https://cldn.com/ont/equipment> ,
               <https://cldn.com/ont/route-schedule> ,
               <https://cldn.com/ont/consignment> ,
               <https://cldn.com/ont/financial> ,
               <https://cldn.com/ont/booking> .
