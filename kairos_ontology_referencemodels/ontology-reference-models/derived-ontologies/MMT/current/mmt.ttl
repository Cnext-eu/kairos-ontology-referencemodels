@prefix : <https://www.kairosflow.ai/ont/mmt#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/mmt> a owl:Ontology ;
    dcterms:title "Kairos Multi-Modal Transport (MMT) Ontology" ;
    dcterms:description """UN/CEFACT Multi-Modal Transport Reference Data Model ontology for international logistics and freight transport.
    
    This ontology provides a comprehensive semantic framework for multi-modal transport operations, covering:
    - Transport service execution and routing
    - Consignments and cargo handling
    - Transport equipment (containers, vehicles, units)
    - Transport events and milestones
    - Transport documents and instructions
    - Party roles in logistics operations
    - Locations, routes, and transport legs
    - Cross-border and customs processes
    - Dangerous goods and special cargo
    
    Fully aligned with UN/CEFACT MMT Reference Data Model for global supply chain interoperability.
    
    This root ontology is a pure aggregator: it declares no terms of its own and imports
    all 11 domain modules. Dangerous-goods terms previously declared here were extracted
    to `mmt/dangerous-goods` at MMT 3.0.0 — see the MMT README for the IRI mapping.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-08-17"^^xsd:date ;
    owl:versionInfo "3.0.0" ;
    dcterms:source "UN/CEFACT Multi-Modal Transport Reference Data Model v1.0 (RABIE v101)" ;
    rdfs:seeAlso <https://unece.org/trade/uncefact/rdm> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/consignment> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/dangerous-goods> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/cargo> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/equipment> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/transport-means> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/party> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/locations> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/documents> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/events> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/route-network> ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/inland-transport> .

