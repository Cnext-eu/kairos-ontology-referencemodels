@prefix : <https://www.kairosflow.ai/ont/mmt/locations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mmt-evt: <https://www.kairosflow.ai/ont/mmt/events#> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/mmt/locations> a owl:Ontology ;
    dcterms:title "MMT Locations Domain" ;
    dcterms:description """Location classes for the Kairos Multi-Modal Transport ontology.

    Covers ports, airports, rail terminals, road terminals, inland ports, border crossings,
    warehouses, distribution centers, and general terminals.
    Based on UN/CEFACT MMT Reference Data Model.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:versionInfo "3.0.0" ;
    dcterms:source "UN/CEFACT Multi-Modal Transport Reference Data Model" ;
    owl:imports <https://www.kairosflow.ai/ont/mmt/events> ;
    rdfs:seeAlso <https://unece.org/trade/uncefact/rdm> .

#################################################################
#    Location Classes
#################################################################

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment """A physical place relevant to transport operations.

    Properties: unLocationCode, locationName, locationType.
    UN/CEFACT MMT-RDM: LogisticsLocationType — unLocationCode is the
    UN/LOCODE; locationName is the name of the location; locationType
    is the type of location (port, airport, terminal, warehouse).""" .

:TransportLocation a owl:Class ;
    rdfs:label "Transport Location" ;
    rdfs:comment """A location where transport activities occur.

    Properties: locationRole, locationCode.
    UN/CEFACT MMT-RDM: LogisticsLocationType — locationRole is the role
    of the location (loading, discharge, transit); locationCode is the
    code identifying the transport location.""" ;
    rdfs:subClassOf :Location .

:Port a owl:Class ;
    rdfs:label "Port" ;
    rdfs:comment """A maritime facility for vessel operations.

    Properties: portName, portType.
    UN/CEFACT MMT-RDM: LogisticsLocationType — portName is the name of
    the port; portType is the type of port (sea, river).""" ;
    rdfs:subClassOf :TransportLocation .

:Airport a owl:Class ;
    rdfs:label "Airport" ;
    rdfs:comment """An air transport facility.

    Properties: iataAirportCode, icaoAirportCode, airportName.
    UN/CEFACT MMT-RDM: LogisticsLocationType — iataAirportCode is the
    3-letter IATA code; icaoAirportCode is the 4-letter ICAO code;
    airportName is the name of the airport.""" ;
    rdfs:subClassOf :TransportLocation .

:RailTerminal a owl:Class ;
    rdfs:label "Rail Terminal" ;
    rdfs:comment """A facility for rail freight operations.

    Properties: railTerminalCode, railTerminalName.
    UN/CEFACT MMT-RDM: LogisticsLocationType — railTerminalCode is the
    terminal identification code; railTerminalName is the name of the rail
    terminal.""" ;
    rdfs:subClassOf :TransportLocation .

:RoadTerminal a owl:Class ;
    rdfs:label "Road Terminal" ;
    rdfs:comment """A facility for road freight operations.

    Properties: roadTerminalCode, roadTerminalName.
    UN/CEFACT MMT-RDM: LogisticsLocationType — roadTerminalCode is the
    terminal identification code; roadTerminalName is the name of the road
    terminal.""" ;
    rdfs:subClassOf :TransportLocation .

:InlandPort a owl:Class ;
    rdfs:label "Inland Port" ;
    rdfs:comment """A port on inland waterways.

    Properties: portCode, portName.
    UN/CEFACT MMT-RDM: LogisticsLocationType — portCode is the UN/LOCODE
    or inland port code; portName is the name of the inland port.""" ;
    rdfs:subClassOf :TransportLocation .

:BorderCrossing a owl:Class ;
    rdfs:label "Border Crossing" ;
    rdfs:comment """A location where goods cross national borders.

    Properties: crossingCode, crossingName.
    UN/CEFACT MMT-RDM: LogisticsLocationType — crossingCode is the code
    for the border crossing; crossingName is the name of the border
    crossing.""" ;
    rdfs:subClassOf :TransportLocation .

:Warehouse a owl:Class ;
    rdfs:label "Warehouse" ;
    rdfs:comment """A storage facility for goods.

    Properties: warehouseCode, warehouseType.
    UN/CEFACT MMT-RDM: LogisticsLocationType — warehouseCode is the
    warehouse identification code; warehouseType is the type of warehouse
    (bonded, general, cold storage).""" ;
    rdfs:subClassOf :Location .

:Terminal a owl:Class ;
    rdfs:label "Terminal" ;
    rdfs:comment """A facility for cargo handling and transfer.

    Properties: terminalCode, terminalType.
    UN/CEFACT MMT-RDM: LogisticsLocationType — terminalCode is the
    terminal identification code; terminalType is the type of terminal
    (container, freight, multi-purpose).""" ;
    rdfs:subClassOf :TransportLocation .

:DistributionCenter a owl:Class ;
    rdfs:label "Distribution Center" ;
    rdfs:comment """A facility for sorting, consolidating, and distributing cargo.

    Properties: distributionCenterCode, distributionCenterType.
    UN/CEFACT MMT-RDM: LogisticsLocationType — distributionCenterCode is
    the DC identification code; distributionCenterType is the type of
    distribution center (cross-dock, fulfilment, regional hub).""" ;
    rdfs:subClassOf :Warehouse .

#################################################################
#    Object Properties
#################################################################

:occursAtLocation a owl:ObjectProperty ;
    rdfs:label "occurs at location" ;
    rdfs:comment "Relates event to location where it occurred." ;
    rdfs:domain mmt-evt:TransportEvent ;
    rdfs:range :Location .

#################################################################
#    Datatype Properties
#################################################################

:unLocationCode a owl:DatatypeProperty ;
    rdfs:label "UN location code" ;
    rdfs:comment "UN/LOCODE for location (5 characters)." ;
    rdfs:domain :Location ;
    rdfs:range xsd:string .

:iataAirportCode a owl:DatatypeProperty ;
    rdfs:label "IATA airport code" ;
    rdfs:comment "3-letter IATA airport code." ;
    rdfs:domain :Airport ;
    rdfs:range xsd:string .

:icaoAirportCode a owl:DatatypeProperty ;
    rdfs:label "ICAO airport code" ;
    rdfs:comment "4-letter ICAO airport code." ;
    rdfs:domain :Airport ;
    rdfs:range xsd:string .

#################################################################
#    Additional Datatype Properties (UN/CEFACT MMT-RDM)
#################################################################

:locationName a owl:DatatypeProperty ;
    rdfs:label "location name" ;
    rdfs:comment "Name of the location. UN/CEFACT MMT-RDM: LogisticsLocationType location name." ;
    rdfs:domain :Location ;
    rdfs:range xsd:string .

:locationType a owl:DatatypeProperty ;
    rdfs:label "location type" ;
    rdfs:comment "Type of location (port, airport, terminal, warehouse). UN/CEFACT MMT-RDM: LogisticsLocationType location type." ;
    rdfs:domain :Location ;
    rdfs:range xsd:string .

:locationRole a owl:DatatypeProperty ;
    rdfs:label "location role" ;
    rdfs:comment "Role of the location (loading, discharge, transit). UN/CEFACT MMT-RDM: LogisticsLocationType location role." ;
    rdfs:domain :TransportLocation ;
    rdfs:range xsd:string .

:locationCode a owl:DatatypeProperty ;
    rdfs:label "location code" ;
    rdfs:comment "Code identifying the transport location. UN/CEFACT MMT-RDM: LogisticsLocationType location code." ;
    rdfs:domain :TransportLocation ;
    rdfs:range xsd:string .

:portName a owl:DatatypeProperty ;
    rdfs:label "port name" ;
    rdfs:comment "Name of the port. UN/CEFACT MMT-RDM: LogisticsLocationType port name." ;
    rdfs:domain :Port ;
    rdfs:range xsd:string .

:portType a owl:DatatypeProperty ;
    rdfs:label "port type" ;
    rdfs:comment "Type of port (sea, river). UN/CEFACT MMT-RDM: LogisticsLocationType port type." ;
    rdfs:domain :Port ;
    rdfs:range xsd:string .

:airportName a owl:DatatypeProperty ;
    rdfs:label "airport name" ;
    rdfs:comment "Name of the airport. UN/CEFACT MMT-RDM: LogisticsLocationType airport name." ;
    rdfs:domain :Airport ;
    rdfs:range xsd:string .

:railTerminalCode a owl:DatatypeProperty ;
    rdfs:label "rail terminal code" ;
    rdfs:comment "Terminal identification code for rail terminal. UN/CEFACT MMT-RDM: LogisticsLocationType terminal code." ;
    rdfs:domain :RailTerminal ;
    rdfs:range xsd:string .

:railTerminalName a owl:DatatypeProperty ;
    rdfs:label "rail terminal name" ;
    rdfs:comment "Name of the rail terminal. UN/CEFACT MMT-RDM: LogisticsLocationType terminal name." ;
    rdfs:domain :RailTerminal ;
    rdfs:range xsd:string .

:roadTerminalCode a owl:DatatypeProperty ;
    rdfs:label "road terminal code" ;
    rdfs:comment "Terminal identification code for road terminal. UN/CEFACT MMT-RDM: LogisticsLocationType terminal code." ;
    rdfs:domain :RoadTerminal ;
    rdfs:range xsd:string .

:roadTerminalName a owl:DatatypeProperty ;
    rdfs:label "road terminal name" ;
    rdfs:comment "Name of the road terminal. UN/CEFACT MMT-RDM: LogisticsLocationType terminal name." ;
    rdfs:domain :RoadTerminal ;
    rdfs:range xsd:string .

:portCode a owl:DatatypeProperty ;
    rdfs:label "port code" ;
    rdfs:comment "UN/LOCODE or inland port code. UN/CEFACT MMT-RDM: LogisticsLocationType port code." ;
    rdfs:domain :InlandPort ;
    rdfs:range xsd:string .

:inlandPortName a owl:DatatypeProperty ;
    rdfs:label "inland port name" ;
    rdfs:comment "Name of the inland port. UN/CEFACT MMT-RDM: LogisticsLocationType port name." ;
    rdfs:domain :InlandPort ;
    rdfs:range xsd:string .

:crossingCode a owl:DatatypeProperty ;
    rdfs:label "crossing code" ;
    rdfs:comment "Code for the border crossing. UN/CEFACT MMT-RDM: LogisticsLocationType crossing code." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:crossingName a owl:DatatypeProperty ;
    rdfs:label "crossing name" ;
    rdfs:comment "Name of the border crossing. UN/CEFACT MMT-RDM: LogisticsLocationType crossing name." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:warehouseCode a owl:DatatypeProperty ;
    rdfs:label "warehouse code" ;
    rdfs:comment "Warehouse identification code. UN/CEFACT MMT-RDM: LogisticsLocationType warehouse code." ;
    rdfs:domain :Warehouse ;
    rdfs:range xsd:string .

:warehouseType a owl:DatatypeProperty ;
    rdfs:label "warehouse type" ;
    rdfs:comment "Type of warehouse (bonded, general, cold storage). UN/CEFACT MMT-RDM: LogisticsLocationType warehouse type." ;
    rdfs:domain :Warehouse ;
    rdfs:range xsd:string .

:terminalCode a owl:DatatypeProperty ;
    rdfs:label "terminal code" ;
    rdfs:comment "Terminal identification code. UN/CEFACT MMT-RDM: LogisticsLocationType terminal code." ;
    rdfs:domain :Terminal ;
    rdfs:range xsd:string .

:terminalType a owl:DatatypeProperty ;
    rdfs:label "terminal type" ;
    rdfs:comment "Type of terminal (container, freight, multi-purpose). UN/CEFACT MMT-RDM: LogisticsLocationType terminal type." ;
    rdfs:domain :Terminal ;
    rdfs:range xsd:string .

:distributionCenterCode a owl:DatatypeProperty ;
    rdfs:label "distribution center code" ;
    rdfs:comment "DC identification code. UN/CEFACT MMT-RDM: LogisticsLocationType distribution center code." ;
    rdfs:domain :DistributionCenter ;
    rdfs:range xsd:string .

:distributionCenterType a owl:DatatypeProperty ;
    rdfs:label "distribution center type" ;
    rdfs:comment "Type of distribution center (cross-dock, fulfilment, regional hub). UN/CEFACT MMT-RDM: LogisticsLocationType distribution center type." ;
    rdfs:domain :DistributionCenter ;
    rdfs:range xsd:string .
