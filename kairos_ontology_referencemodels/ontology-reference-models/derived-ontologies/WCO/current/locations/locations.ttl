@prefix : <https://www.kairosflow.ai/ont/wco/locations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wco-customs: <https://www.kairosflow.ai/ont/wco/customs#> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/wco/locations> a owl:Ontology ;
    dcterms:title "WCO Locations Domain" ;
    dcterms:description "Customs locations, border crossings, bonded facilities, and controlled areas based on the WCO Data Model 3.10.0." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    dcterms:source "WCO Data Model 3.10.0, eFTI Regulation (EU) 2020/1056" ;
    rdfs:seeAlso <https://www.wcoomd.org/datamodel> .

#################################################################
#    Classes
#################################################################

:CustomsOffice a owl:Class ;
    rdfs:label "Customs Office" ;
    rdfs:comment """A government facility where customs formalities are performed.

    WCO (Data Model 3.10.0): Designated office where customs formalities are carried out. Own datatype
    properties: officeCode, officeName, officeType (WCO: entry, exit, or internal customs office), and
    officeCountryCode (ISO 3166-1 alpha-2 country code of the customs office). See
    https://www.wcoomd.org/datamodel.""" ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/dcsa/locations#Facility> ,
                 <https://www.kairosflow.ai/ont/mmt/locations#Location> ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :officeCode ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:BorderCrossing a owl:Class ;
    rdfs:label "Border Crossing" ;
    rdfs:comment """An authorized point for entering or exiting a national territory.

    WCO (Data Model 3.10.0): Authorized point of entry or exit at a national border. Own datatype
    properties: borderCrossingCode, borderCrossingName, borderCrossingType (WCO: type of crossing —
    road, rail, air, sea, inland waterway), and borderCountryCode (ISO 3166-1 alpha-2 country code
    of the country at the border crossing).""" ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/imo/port-call#Port> ,
                 <https://www.kairosflow.ai/ont/dcsa/locations#UNLocationCode> ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :borderCrossingCode ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:BondedWarehouse a owl:Class ;
    rdfs:label "Bonded Warehouse" ;
    rdfs:comment """A secure facility approved by customs for storing goods under customs control.

    WCO: Secure premises approved by customs for storing goods under customs control without payment of duties.""" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :warehouseApprovalNumber ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:FreeZone a owl:Class ;
    rdfs:label "Free Zone" ;
    rdfs:comment """A designated area where goods are treated as outside the customs territory for duty purposes.

    WCO (Revised Kyoto Convention, Specific Annex D): Designated area within a customs territory where
    goods are treated as outside the customs territory for duty purposes. Own datatype properties:
    freeZoneIdentifier, freeZoneType (WCO: type of free zone — industrial, commercial, special-purpose),
    freeZoneAreaCode (national code identifying the free zone area), and freeZoneAuthorizingAuthority
    (authority that authorized the establishment of the free zone).""" .

:CustomsControlledArea a owl:Class ;
    rdfs:label "Customs Controlled Area" ;
    rdfs:comment """An area designated by customs authorities for examination, storage, or processing of goods.

    WCO (Data Model 3.10.0 + RKC): Any area designated by customs authorities for examination, storage,
    or processing of goods under customs supervision. Own datatype properties: areaIdentifier, areaType
    (WCO: type of controlled area — customs warehouse, free zone, temporary storage, examination area),
    and areaSupervisingOfficeCode (code of the customs office supervising the controlled area).""" .

:DesignatedExportPlace a owl:Class ;
    rdfs:label "Designated Export Place" ;
    rdfs:comment """An approved location where export formalities and customs clearance are performed.

    WCO (Revised Kyoto Convention): Approved location where export formalities and customs clearance are
    performed. Own datatype properties: placeCode, placeType (WCO: type of designated export place —
    approved exporter premises, customs office, border crossing), and placeSupervisingOfficeCode (code
    of the customs office supervising the designated export place).""" .

#################################################################
#    Object Properties
#################################################################

:locatedAtCustomsOffice a owl:ObjectProperty ;
    rdfs:label "located at customs office" ;
    rdfs:comment "The customs office associated with this entity." ;
    rdfs:domain wco-customs:CustomsDeclaration ;
    rdfs:range :CustomsOffice .

:hasBorderCrossing a owl:ObjectProperty ;
    rdfs:label "has border crossing" ;
    rdfs:comment "The border crossing point associated with this entity." ;
    rdfs:domain wco-customs:TransitDeclaration ;
    rdfs:range :BorderCrossing .

:storedInBondedWarehouse a owl:ObjectProperty ;
    rdfs:label "stored in bonded warehouse" ;
    rdfs:comment "The bonded warehouse where goods are stored." ;
    rdfs:domain wco-customs:ImportDeclaration ;
    rdfs:range :BondedWarehouse .

:locatedInFreeZone a owl:ObjectProperty ;
    rdfs:label "located in free zone" ;
    rdfs:comment "The free zone in which this entity is located." ;
    rdfs:domain wco-customs:CustomsDeclaration ;
    rdfs:range :FreeZone .

:withinCustomsControlledArea a owl:ObjectProperty ;
    rdfs:label "within customs controlled area" ;
    rdfs:comment "The customs controlled area in which this entity is situated." ;
    rdfs:domain wco-customs:CustomsDeclaration ;
    rdfs:range :CustomsControlledArea .

:hasDesignatedExportPlace a owl:ObjectProperty ;
    rdfs:label "has designated export place" ;
    rdfs:comment "The designated export place associated with this entity." ;
    rdfs:domain wco-customs:ExportDeclaration ;
    rdfs:range :DesignatedExportPlace .

:supervisedBy a owl:ObjectProperty ;
    rdfs:label "supervised by" ;
    rdfs:comment "The customs office supervising this bonded facility." ;
    rdfs:domain :BondedWarehouse ;
    rdfs:range :CustomsOffice .

#################################################################
#    Datatype Properties
#################################################################

:officeCode a owl:DatatypeProperty ;
    rdfs:label "office code" ;
    rdfs:comment "UN/LOCODE or national customs office code." ;
    rdfs:domain :CustomsOffice ;
    rdfs:range xsd:string .

:officeName a owl:DatatypeProperty ;
    rdfs:label "office name" ;
    rdfs:comment "Human-readable name of the customs office." ;
    rdfs:domain :CustomsOffice ;
    rdfs:range xsd:string .

:borderCrossingCode a owl:DatatypeProperty ;
    rdfs:label "border crossing code" ;
    rdfs:comment "Code identifying the border crossing point." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:borderCrossingName a owl:DatatypeProperty ;
    rdfs:label "border crossing name" ;
    rdfs:comment "Human-readable name of the border crossing." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:warehouseApprovalNumber a owl:DatatypeProperty ;
    rdfs:label "warehouse approval number" ;
    rdfs:comment "Customs-issued approval number for the bonded warehouse." ;
    rdfs:domain :BondedWarehouse ;
    rdfs:range xsd:string .

:warehouseType a owl:DatatypeProperty ;
    rdfs:label "warehouse type" ;
    rdfs:comment "Classification of the bonded warehouse (e.g., public, private)." ;
    rdfs:domain :BondedWarehouse ;
    rdfs:range xsd:string .

:freeZoneIdentifier a owl:DatatypeProperty ;
    rdfs:label "free zone identifier" ;
    rdfs:comment "Code or identifier for the free zone." ;
    rdfs:domain :FreeZone ;
    rdfs:range xsd:string .

:areaIdentifier a owl:DatatypeProperty ;
    rdfs:label "area identifier" ;
    rdfs:comment "Code or identifier for the customs controlled area." ;
    rdfs:domain :CustomsControlledArea ;
    rdfs:range xsd:string .

:placeCode a owl:DatatypeProperty ;
    rdfs:label "place code" ;
    rdfs:comment "Code identifying the designated export place." ;
    rdfs:domain :DesignatedExportPlace ;
    rdfs:range xsd:string .

:officeType a owl:DatatypeProperty ;
    rdfs:label "office type" ;
    rdfs:comment "Type of customs office: entry, exit, or internal (WCO Data Model 3.10.0)." ;
    rdfs:domain :CustomsOffice ;
    rdfs:range xsd:string .

:officeCountryCode a owl:DatatypeProperty ;
    rdfs:label "office country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code of the customs office (WCO Data Model 3.10.0)." ;
    rdfs:domain :CustomsOffice ;
    rdfs:range xsd:string .

:borderCrossingType a owl:DatatypeProperty ;
    rdfs:label "border crossing type" ;
    rdfs:comment "Type of border crossing: road, rail, air, sea, or inland waterway (WCO Data Model 3.10.0)." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:borderCountryCode a owl:DatatypeProperty ;
    rdfs:label "border country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code of the country at the border crossing (WCO Data Model 3.10.0)." ;
    rdfs:domain :BorderCrossing ;
    rdfs:range xsd:string .

:freeZoneType a owl:DatatypeProperty ;
    rdfs:label "free zone type" ;
    rdfs:comment "Type of free zone: industrial, commercial, or special-purpose (WCO Revised Kyoto Convention, Specific Annex D)." ;
    rdfs:domain :FreeZone ;
    rdfs:range xsd:string .

:freeZoneAreaCode a owl:DatatypeProperty ;
    rdfs:label "free zone area code" ;
    rdfs:comment "National code identifying the free zone area (WCO Revised Kyoto Convention)." ;
    rdfs:domain :FreeZone ;
    rdfs:range xsd:string .

:freeZoneAuthorizingAuthority a owl:DatatypeProperty ;
    rdfs:label "free zone authorizing authority" ;
    rdfs:comment "Authority that authorized the establishment of the free zone (WCO Revised Kyoto Convention)." ;
    rdfs:domain :FreeZone ;
    rdfs:range xsd:string .

:areaType a owl:DatatypeProperty ;
    rdfs:label "area type" ;
    rdfs:comment "Type of customs controlled area: customs warehouse, free zone, temporary storage, or examination area (WCO Data Model 3.10.0)." ;
    rdfs:domain :CustomsControlledArea ;
    rdfs:range xsd:string .

:areaSupervisingOfficeCode a owl:DatatypeProperty ;
    rdfs:label "area supervising office code" ;
    rdfs:comment "Code of the customs office supervising the controlled area (WCO Data Model 3.10.0)." ;
    rdfs:domain :CustomsControlledArea ;
    rdfs:range xsd:string .

:placeType a owl:DatatypeProperty ;
    rdfs:label "place type" ;
    rdfs:comment "Type of designated export place: approved exporter premises, customs office, or border crossing (WCO Revised Kyoto Convention)." ;
    rdfs:domain :DesignatedExportPlace ;
    rdfs:range xsd:string .

:placeSupervisingOfficeCode a owl:DatatypeProperty ;
    rdfs:label "place supervising office code" ;
    rdfs:comment "Code of the customs office supervising the designated export place (WCO Revised Kyoto Convention)." ;
    rdfs:domain :DesignatedExportPlace ;
    rdfs:range xsd:string .

:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "Geographic latitude coordinate in decimal degrees." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( :CustomsOffice :BorderCrossing :BondedWarehouse :FreeZone :CustomsControlledArea :DesignatedExportPlace )
    ] ;
    rdfs:range xsd:decimal .

:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "Geographic longitude coordinate in decimal degrees." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( :CustomsOffice :BorderCrossing :BondedWarehouse :FreeZone :CustomsControlledArea :DesignatedExportPlace )
    ] ;
    rdfs:range xsd:decimal .
