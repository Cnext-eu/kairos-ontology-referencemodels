@prefix : <https://www.kairosflow.ai/ont/dcsa/container-operations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix equip: <https://www.kairosflow.ai/ont/dcsa/equipment#> .
@prefix loc: <https://www.kairosflow.ai/ont/dcsa/locations#> .
@prefix evt: <https://www.kairosflow.ai/ont/dcsa/events#> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/dcsa/container-operations> a owl:Ontology ;
    dcterms:title "DCSA Container Operations Domain" ;
    dcterms:description """Container lifecycle and operational concepts for container shipping.
    
    Operational modeling patterns derived from DCSA equipment event types
    (GTIN, GTOT, LOAD, DISC, STUF, STRP). These classes provide a lifecycle
    abstraction over DCSA's event-driven container tracking model.
    
    Covers container journey tracking, operational status management,
    stuffing/stripping operations, and Lift-on/Lift-off (LoLo) handling.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:versionInfo "1.5.0" ;
    dcterms:source "DCSA Track & Trace API v2.2 (equipment event types)" ;
    rdfs:seeAlso <https://github.com/dcsaorg/DCSA-OpenAPI> .

#################################################################
#    Container Operations Classes
#################################################################

:ContainerJourney a owl:Class ;
    rdfs:label "Container Journey" ;
    rdfs:comment """The complete lifecycle of a container from empty pickup to empty return.
    
    DCSA: Represents the full operational cycle of a container within a
    single booking/shipment, covering all phases from depot release through
    cargo stuffing, transport, unstuffing, and return to depot.""" .

:ContainerOperationalStatus a owl:Class ;
    rdfs:label "Container Operational Status" ;
    rdfs:comment """The current operational state of a container in the shipping lifecycle.
    
    DCSA: Tracks whether a container is available, in-use, in-transit,
    or returned. Used for fleet management and container tracking.
    DCSA Track & Trace: operational status is derived from equipmentEventTypeCode
    (17 codes: LOAD, DISC, GTIN, GTOT, STUF, STRP, PICK, etc.), eventClassifierCode
    (ACT/PLN/EST), emptyIndicatorCode (EMPTY/LADEN), and facilityTypeCode.""" .

:ContainerStuffing a owl:Class ;
    rdfs:label "Container Stuffing" ;
    rdfs:comment """The process of loading cargo into a container.
    
    DCSA: Packing of goods into a container, typically at shipper premises
    or a container freight station (CFS).""" .

:ContainerStripping a owl:Class ;
    rdfs:label "Container Stripping" ;
    rdfs:comment """The process of unloading cargo from a container.
    
    DCSA: Unpacking of goods from a container at destination, typically
    at consignee premises or CFS. Corresponds to DCSA equipmentEventTypeCode
    STRP in the Track & Trace API.""" .

:LiftOnLiftOff a owl:Class ;
    rdfs:label "Lift-On/Lift-Off (LoLo)" ;
    rdfs:comment """A container handling operation where containers are lifted on or off
    a vessel, truck, or rail car using crane equipment.
    
    DCSA: Standard container handling method at terminals using ship-to-shore
    cranes, rubber-tyred gantry cranes, or reach stackers. Corresponds to DCSA
    equipmentEventTypeCode LOAD (lift-on) or DISC (lift-off/discharge) in the
    Track & Trace API. The isTransshipmentMove flag distinguishes transshipment
    lifts from origin/destination lifts.""" .

#################################################################
#    Object Properties
#################################################################

:hasContainerJourney a owl:ObjectProperty ;
    rdfs:label "has container journey" ;
    rdfs:comment "Relates a container or shipment to its container journey lifecycle." ;
    rdfs:domain equip:Container ;
    rdfs:range :ContainerJourney .

:hasOperationalStatus a owl:ObjectProperty ;
    rdfs:label "has operational status" ;
    rdfs:comment "Relates a container to its current operational status." ;
    rdfs:domain :ContainerJourney ;
    rdfs:range :ContainerOperationalStatus .

:hasStuffingOperation a owl:ObjectProperty ;
    rdfs:label "has stuffing operation" ;
    rdfs:comment "Relates a container journey to its stuffing operation." ;
    rdfs:domain :ContainerJourney ;
    rdfs:range :ContainerStuffing .

:hasStrippingOperation a owl:ObjectProperty ;
    rdfs:label "has stripping operation" ;
    rdfs:comment "Relates a container journey to its stripping operation." ;
    rdfs:domain :ContainerJourney ;
    rdfs:range :ContainerStripping .

:hasLoLoOperation a owl:ObjectProperty ;
    rdfs:label "has LoLo operation" ;
    rdfs:comment "Relates a container journey to a lift-on/lift-off operation." ;
    rdfs:domain :ContainerJourney ;
    rdfs:range :LiftOnLiftOff .

#################################################################
#    Datatype Properties
#################################################################

:journeyStatus a owl:DatatypeProperty ;
    rdfs:label "journey status" ;
    rdfs:comment "Current phase of container journey: EMPTY_PICKUP, STUFFING, GATE_IN, LOADED_ON_VESSEL, IN_TRANSIT, DISCHARGED, GATE_OUT, STRIPPING, EMPTY_RETURN." ;
    rdfs:domain :ContainerJourney ;
    rdfs:range xsd:string .

:operationalStatusCode a owl:DatatypeProperty ;
    rdfs:label "operational status code" ;
    rdfs:comment "Code representing container operational status: AVAILABLE, IN_USE, IN_TRANSIT, AT_TERMINAL, RETURNED, MAINTENANCE." ;
    rdfs:domain :ContainerOperationalStatus ;
    rdfs:range xsd:string .

:statusTimestamp a owl:DatatypeProperty ;
    rdfs:label "status timestamp" ;
    rdfs:comment "Date and time when the operational status was recorded." ;
    rdfs:domain :ContainerOperationalStatus ;
    rdfs:range xsd:dateTime .

:stuffingDate a owl:DatatypeProperty ;
    rdfs:label "stuffing date" ;
    rdfs:comment "Date when container stuffing occurred or is planned." ;
    rdfs:domain :ContainerStuffing ;
    rdfs:range xsd:dateTime .

:strippingDate a owl:DatatypeProperty ;
    rdfs:label "stripping date" ;
    rdfs:comment "Date when container stripping occurred or is planned." ;
    rdfs:domain :ContainerStripping ;
    rdfs:range xsd:dateTime .

:loloType a owl:DatatypeProperty ;
    rdfs:label "LoLo type" ;
    rdfs:comment "Type of LoLo operation: LIFT_ON or LIFT_OFF." ;
    rdfs:domain :LiftOnLiftOff ;
    rdfs:range xsd:string .

:loloTimestamp a owl:DatatypeProperty ;
    rdfs:label "LoLo timestamp" ;
    rdfs:comment "Date and time when the lift-on/lift-off operation occurred." ;
    rdfs:domain :LiftOnLiftOff ;
    rdfs:range xsd:dateTime .

#################################################################
#    Cross-Domain Object Properties
#################################################################

:atLocation a owl:ObjectProperty ;
    rdfs:label "at location" ;
    rdfs:comment "The location where this container operation takes place." ;
    rdfs:domain :ContainerStuffing ;
    rdfs:range loc:Location .

:triggeredByEvent a owl:ObjectProperty ;
    rdfs:label "triggered by event" ;
    rdfs:comment "The equipment event that triggered or recorded this container operation." ;
    rdfs:domain :ContainerStuffing ;
    rdfs:range evt:EquipmentEvent .

#################################################################
#    Enriched Properties — DCSA Track & Trace API
#################################################################

:equipmentEventTypeCode a owl:DatatypeProperty ;
    rdfs:label "equipment event type code" ;
    rdfs:comment """DCSA Track & Trace: type code for the equipment event.
    DCSA enum: LOAD, DISC, GTIN, GTOT, STUF, STRP, PICK, etc. (17 codes total).""" ;
    rdfs:domain :ContainerOperationalStatus ;
    rdfs:range xsd:string .

:emptyIndicatorCode a owl:DatatypeProperty ;
    rdfs:label "empty indicator code" ;
    rdfs:comment "DCSA Track & Trace: indicates whether the container is EMPTY or LADEN at the time of the event." ;
    rdfs:domain :ContainerOperationalStatus ;
    rdfs:range xsd:string .

:facilityTypeCode a owl:DatatypeProperty ;
    rdfs:label "facility type code" ;
    rdfs:comment "DCSA Track & Trace: type of facility where the event occurred (e.g., TRM, PRT, RLY)." ;
    rdfs:domain :ContainerOperationalStatus ;
    rdfs:range xsd:string .

:isTransshipmentMove a owl:DatatypeProperty ;
    rdfs:label "is transshipment move" ;
    rdfs:comment "DCSA Track & Trace: boolean indicating whether this LoLo or event is a transshipment move (vessel-to-vessel)." ;
    rdfs:domain :LiftOnLiftOff ;
    rdfs:range xsd:boolean .

:equipmentReference a owl:DatatypeProperty ;
    rdfs:label "equipment reference" ;
    rdfs:comment "DCSA Track & Trace: unique reference identifying the container equipment involved in the stripping/LoLo operation." ;
    rdfs:domain :ContainerStripping ;
    rdfs:range xsd:string .

:strippingEmptyIndicatorCode a owl:DatatypeProperty ;
    rdfs:label "stripping empty indicator code" ;
    rdfs:comment "DCSA Track & Trace: empty/laden indicator for the container at stripping time (EMPTY/LADEN)." ;
    rdfs:domain :ContainerStripping ;
    rdfs:range xsd:string .

:strippingFacilityTypeCode a owl:DatatypeProperty ;
    rdfs:label "stripping facility type code" ;
    rdfs:comment "DCSA Track & Trace: facility type where stripping occurred (e.g., CFS, TRM)." ;
    rdfs:domain :ContainerStripping ;
    rdfs:range xsd:string .

:loloEquipmentEventTypeCode a owl:DatatypeProperty ;
    rdfs:label "LoLo equipment event type code" ;
    rdfs:comment "DCSA Track & Trace: event type code for this LoLo operation (LOAD for lift-on, DISC for lift-off)." ;
    rdfs:domain :LiftOnLiftOff ;
    rdfs:range xsd:string .

:loloTransportCallReference a owl:DatatypeProperty ;
    rdfs:label "LoLo transport call reference" ;
    rdfs:comment "DCSA Track & Trace: reference to the transport call (vessel/voyage) associated with this LoLo operation." ;
    rdfs:domain :LiftOnLiftOff ;
    rdfs:range xsd:string .
