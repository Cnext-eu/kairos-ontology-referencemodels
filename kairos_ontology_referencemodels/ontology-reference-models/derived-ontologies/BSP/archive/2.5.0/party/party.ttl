@prefix : <https://www.kairosflow.ai/ont/bsp/party#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix comm: <https://www.kairosflow.ai/ont/bsp/commercial#> .
@prefix ref-data: <https://www.kairosflow.ai/ont/bsp/reference-data#> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/bsp/party> a owl:Ontology ;
    dcterms:title "Kairos BSP Party Domain Ontology" ;
    dcterms:description """Party and organisation domain of the Buy-Ship-Pay Reference Data Model.

    This module defines all trade party roles participating in the buy-ship-pay lifecycle, including:
    - Buyer, Seller, Shipper, Consignee, Carrier
    - Financial institutions (Banks)
    - Intermediaries (Freight Forwarder, Customs Broker)
    - Supply chain participants (Manufacturer, Supplier, Notify Party)

    Since 1.6.0 roles are modelled via the qualified-role-assignment pattern
    (TradePartyRoleAssignment + hasRole over the governed PartyRoleCode list);
    the role subclasses remain as deprecated standards overlays.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-08-15"^^xsd:date ;
    owl:versionInfo "2.5.0" ;
    dcterms:source "UN/CEFACT Buy-Ship-Pay Reference Data Model (BSP-RDM v1.0)" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/reference-data> ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/commercial> ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/> .

#################################################################
#    Party Role Classes
#
#    DEPRECATED AS ROLE MODEL (BSP 1.6.0). The role subclasses below are
#    standards overlays mirroring UN/CEFACT BSP role contexts — kept for
#    source fidelity and message-level interop, but they are the
#    subclass-identity-by-role anti-pattern the qualified-role-assignment
#    pattern rejects: one organisation holding two roles concurrently
#    cannot be represented. Hubs MUST NOT subclass their durable Party
#    identity under these; assign roles via :TradePartyRoleAssignment +
#    :hasRole (Role Assignment section below). See CONTRACT.md,
#    "Patterns vs derived modules", and blueprints/patterns/
#    qualified-role-assignment (deprecated subjects are outside its
#    subclass-identity-by-role detection; un-deprecating revives it).
#################################################################

:TradeParty a owl:Class ;
    rdfs:label "Trade Party" ;
    rdfs:comment """An organization or person participating in trade.
    
    UN/CEFACT BSP: Maps to TradeParty — an individual, a group, or a body
    having a role in a trade business function.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/TradeParty> .

:Buyer a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:comment """The party purchasing goods or services.
    
    UN/CEFACT BSP: A TradeParty role (buyerTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Seller a owl:Class ;
    rdfs:label "Seller" ;
    rdfs:comment """The party selling goods or services.
    
    UN/CEFACT BSP: A TradeParty role (sellerTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Shipper a owl:Class ;
    rdfs:label "Shipper" ;
    rdfs:comment """The party tendering goods for transport (consignor).
    
    UN/CEFACT BSP: A TradeParty role (shipFromTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Consignee a owl:Class ;
    rdfs:label "Consignee" ;
    rdfs:comment """The party to whom goods are shipped.
    
    UN/CEFACT BSP: A TradeParty role (shipToTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:comment """The party providing transport services.
    
    UN/CEFACT BSP: A TradeParty role (carrierTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/dcsa/party#Carrier> ;
    owl:deprecated true .

:FreightForwarder a owl:Class ;
    rdfs:label "Freight Forwarder" ;
    rdfs:comment """A party arranging transport on behalf of shippers.
    
    UN/CEFACT BSP: A TradeParty role (freightForwarderTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:CustomsBroker a owl:Class ;
    rdfs:label "Customs Broker" ;
    rdfs:comment """A party handling customs clearance.
    
    UN/CEFACT BSP: A TradeParty role (customsBrokerTradeParty context).""" ;
    rdfs:subClassOf :TradeParty ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/wco/party#CustomsBroker> ;
    owl:deprecated true .

:Bank a owl:Class ;
    rdfs:label "Bank" ;
    rdfs:comment """A financial institution providing payment and trade finance services.
    
    UN/CEFACT BSP: Maps to PaymentFinancialInstitution / CreditorFinancialInstitution /
    DebtorFinancialInstitution.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/PaymentFinancialInstitution> ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer" ;
    rdfs:comment """The party producing the goods.
    
    UN/CEFACT BSP: A TradeParty role — may be seller or supplier to seller.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment """A party supplying goods or components.
    
    UN/CEFACT BSP: A TradeParty role — upstream provider in supply chain.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:NotifyParty a owl:Class ;
    rdfs:label "Notify Party" ;
    rdfs:comment """A party to be notified of shipment arrival.
    
    ISO BSP: Often consignee or their agent.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

#################################################################
#    Additional Party Roles (v1.3.0)
#################################################################

:InsuranceProvider a owl:Class ;
    rdfs:label "Insurance Provider" ;
    rdfs:comment """A party providing cargo, marine, or trade credit insurance.

    Covers hull and machinery (H&M), protection and indemnity (P&I),
    and cargo insurance underwriters.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:TerminalOperator a owl:Class ;
    rdfs:label "Terminal Operator" ;
    rdfs:comment """A party operating a port terminal, inland terminal, or container
    depot. Responsible for cargo handling, storage, and gate operations.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

:WarehouseKeeper a owl:Class ;
    rdfs:label "Warehouse Keeper" ;
    rdfs:comment """A party providing warehousing and storage services. May operate
    bonded warehouses, free zone warehouses, or general distribution centers.""" ;
    rdfs:subClassOf :TradeParty ;
    owl:deprecated true .

#################################################################
#    Contact Person (v1.4.0)
#################################################################

:Contact a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:comment """A contact person associated with a trade party.

    Modeled as a first-class entity (not scalar party attributes) because a
    party commonly has many contacts (e.g., billing, operations, sales). The
    party-level :contactEmail / :contactPhone remain available as a single
    primary coordinate; per-person details belong on :Contact.

    UN/CEFACT BSP: Maps to TradeContact — a person or department to contact
    in a trade party.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/TradeContact> .

#################################################################
#    Role Assignment (v1.6.0)
#
#    Pattern-conformant role machinery per blueprints/patterns/
#    qualified-role-assignment (naming normative) and governed-code-list.
#    One durable :TradeParty holds 0..n role assignments, each scoped to
#    one context — the same organisation can be shipper on one booking,
#    carrier on another, and a creditor in finance, concurrently, without
#    re-typing or duplicating the party record. The role vocabulary is
#    the set formerly expressed as the deprecated role subclasses above;
#    its governed values are pack/MDM-owned (governed-code-list pattern).
#    Context links follow inContextOf<Context> and are declared by the
#    hub per context class (e.g. inContextOfBooking, inContextOfShipment).
#################################################################

:PartyRoleCode a owl:Class ;
    rdfs:label "Party Role Code" ;
    rdfs:comment """Governed code list of trade-party roles (Buyer, Seller, Shipper,
    Consignee, Carrier, FreightForwarder, CustomsBroker, Bank, Manufacturer,
    Supplier, NotifyParty, InsuranceProvider, TerminalOperator, WarehouseKeeper, ...).

    Named per blueprints/patterns/governed-code-list (<Dimension>Code). The value
    set corresponds to the deprecated role subclasses above; survivorship and
    value governance are a pack-level MDM concern, not fixed by this module.""" .

:TradePartyRoleAssignment a owl:Class ;
    rdfs:label "Trade Party Role Assignment" ;
    rdfs:comment """The (identity, role, context, validity) link entity: one durable
    TradeParty playing one role in one context for some period.

    Named per blueprints/patterns/qualified-role-assignment
    (<Identity>RoleAssignment). This — not the deprecated role subclasses —
    is the shape hubs reuse for role modelling.""" .

:assignedToTradeParty a owl:ObjectProperty ;
    rdfs:label "assigned to trade party" ;
    rdfs:comment "The durable identity holding the role. Named per qualified-role-assignment (assignedTo<Identity>)." ;
    rdfs:domain :TradePartyRoleAssignment ;
    rdfs:range :TradeParty .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment """REUSABLE — no rdfs:domain by design: asserting a domain of
    :TradePartyRoleAssignment would type every hub-local assignment class's
    instances as this module's assignment class, reintroducing the trade
    context the local durable identity exists to avoid (BSP 2.1.0). The role
    held, from the governed PartyRoleCode list. Named per
    qualified-role-assignment (fixed name hasRole, ranging over the pack's
    controlled role vocabulary). The rdfs:range stays: reuse this property
    only when the role vocabulary IS :PartyRoleCode; a hub whose roles span
    other contexts mints a local hasRole per the pattern and can still reuse
    :roleValidFrom and :roleValidTo. schema:domainIncludes is additive,
    non-entailing domain evidence — hubs add their own triple for their
    assignment class.""" ;
    schema:domainIncludes :TradePartyRoleAssignment ;
    rdfs:range :PartyRoleCode .

:roleValidFrom a owl:DatatypeProperty ;
    rdfs:label "role valid from" ;
    rdfs:comment """REUSABLE — no rdfs:domain by design: any role-assignment class,
    reference or hub-local, may carry the validity period (BSP 2.1.0). Start of
    the assignment's validity period, independent of the identity's own
    lifecycle.""" ;
    schema:domainIncludes :TradePartyRoleAssignment ;
    rdfs:range xsd:dateTime .

:roleValidTo a owl:DatatypeProperty ;
    rdfs:label "role valid to" ;
    rdfs:comment """REUSABLE — no rdfs:domain by design: any role-assignment class,
    reference or hub-local, may carry the validity period (BSP 2.1.0). End of
    the assignment's validity period; absent while the assignment holds.""" ;
    schema:domainIncludes :TradePartyRoleAssignment ;
    rdfs:range xsd:dateTime .

#################################################################
#    Object Properties
#################################################################

:hasParty a owl:ObjectProperty ;
    rdfs:label "has party" ;
    rdfs:comment """REUSABLE — no rdfs:domain by design: the typed specialisations
    attach to different subjects (CommercialTransaction, Shipment, Product,
    LetterOfCredit), and asserting a shared domain would infer that class onto
    every hub class using this property. Generic landing pad relating a subject
    to a participating trade party (BSP 2.0.0, mirroring mmt/consignment#hasParty).
    The typed roles :hasBuyer, :hasSeller, :hasShipper, :hasConsignee, :hasCarrier,
    :hasManufacturer and the bsp/financial bank properties are specialisations.
    Cardinality: 0..n. schema:domainIncludes is deliberately not asserted here:
    the subject classes are owned by the specialisations' own rdfs:domain
    declarations, and no single class anchors the landing pad.""" ;
    rdfs:range :TradeParty .

:hasBuyer a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has buyer" ;
    rdfs:comment "Identifies the buyer. Range widened from the deprecated :Buyer overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode BUYER; :Buyer stays declared for message-level interop." ;
    rdfs:domain comm:CommercialTransaction ;
    rdfs:range :TradeParty .

:hasSeller a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has seller" ;
    rdfs:comment "Identifies the seller. Range widened from the deprecated :Seller overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode SELLER; :Seller stays declared for message-level interop." ;
    rdfs:domain comm:CommercialTransaction ;
    rdfs:range :TradeParty .

:hasShipper a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has shipper" ;
    rdfs:comment "Identifies the shipper/consignor. Range widened from the deprecated :Shipper overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode SHIPPER; :Shipper stays declared for message-level interop." ;
    rdfs:domain comm:Shipment ;
    rdfs:range :TradeParty .

:hasConsignee a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has consignee" ;
    rdfs:comment "Identifies the consignee. Range widened from the deprecated :Consignee overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode CONSIGNEE; :Consignee stays declared for message-level interop." ;
    rdfs:domain comm:Shipment ;
    rdfs:range :TradeParty .

:hasCarrier a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has carrier" ;
    rdfs:comment "Identifies the carrier. Range widened from the deprecated :Carrier overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode CARRIER; :Carrier stays declared for message-level interop." ;
    rdfs:domain comm:Shipment ;
    rdfs:range :TradeParty .

:hasManufacturer a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasParty ;
    rdfs:label "has manufacturer" ;
    rdfs:comment "Identifies the manufacturer. Range widened from the deprecated :Manufacturer overlay to :TradeParty (BSP 2.0.0) — the intended role is carried by the property itself and, in role-assignment form, by a TradePartyRoleAssignment with PartyRoleCode MANUFACTURER; :Manufacturer stays declared for message-level interop." ;
    rdfs:domain comm:Product ;
    rdfs:range :TradeParty .

:hasContact a owl:ObjectProperty ;
    rdfs:label "has contact" ;
    rdfs:comment "REUSABLE — no rdfs:domain by design: asserting a domain of :TradeParty would infer TradeParty subsumption onto any hub identity class using this property, re-creating the subclass-identity-by-role anti-pattern by the back door (BSP 1.6.0). Relates a party-like identity to its contact persons. Cardinality: 1:n. schema:domainIncludes carries the reference anchor as non-entailing evidence (BSP 2.1.0)." ;
    schema:domainIncludes :TradeParty ;
    rdfs:range :Contact .

:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment """REUSABLE — no rdfs:domain by design: asserting a domain of :TradeParty
    would infer TradeParty subsumption onto any hub identity class using this
    property (BSP 1.6.0). Relates a party-like identity to one of its
    postal/physical addresses. Cardinality: 1:n — a party may have many
    addresses. The typed roles :hasBillingAddress and :hasShippingAddress are
    specialisations of this generic relationship. The Address class is shared
    master data defined in the BSP reference-data module. schema:domainIncludes
    carries the reference anchor as non-entailing evidence (BSP 2.1.0).""" ;
    schema:domainIncludes :TradeParty ;
    rdfs:range ref-data:Address .

:hasBillingAddress a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasAddress ;
    rdfs:label "has billing address" ;
    rdfs:comment "REUSABLE — no rdfs:domain by design (see :hasAddress). Identifies billing address. Cardinality: 0..1." ;
    schema:domainIncludes :TradeParty ;
    rdfs:range ref-data:Address .

:hasShippingAddress a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasAddress ;
    rdfs:label "has shipping address" ;
    rdfs:comment "REUSABLE — no rdfs:domain by design (see :hasAddress). Identifies shipping/delivery address. Cardinality: 0..1." ;
    schema:domainIncludes :TradeParty ;
    rdfs:range ref-data:Address .

#################################################################
#    Datatype Properties
#################################################################

:partyName a owl:DatatypeProperty ;
    rdfs:label "party name" ;
    rdfs:comment "Name of organization or person." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:partyIdentifier a owl:DatatypeProperty ;
    rdfs:label "party identifier" ;
    rdfs:comment "Unique identifier for party (e.g., DUNS, GLN, tax ID)." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:contactEmail a owl:DatatypeProperty ;
    rdfs:label "contact email" ;
    rdfs:comment "Email address of the party (primary coordinate) or of a specific contact person." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :TradeParty :Contact ) ] ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:label "contact phone" ;
    rdfs:comment "Phone number of the party (primary coordinate) or of a specific contact person." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :TradeParty :Contact ) ] ;
    rdfs:range xsd:string .

:contactName a owl:DatatypeProperty ;
    rdfs:label "contact name" ;
    rdfs:comment "Full name of the contact person." ;
    rdfs:domain :Contact ;
    rdfs:range xsd:string .

:jobTitle a owl:DatatypeProperty ;
    rdfs:label "job title" ;
    rdfs:comment "Job title or position of the contact person." ;
    rdfs:domain :Contact ;
    rdfs:range xsd:string .

:contactRole a owl:DatatypeProperty ;
    rdfs:label "contact role" ;
    rdfs:comment "Functional role of the contact (e.g., billing, operations, sales)." ;
    rdfs:domain :Contact ;
    rdfs:range xsd:string .

#################################################################
#    Datatype Properties — Party Identity (v1.3.0)
#################################################################

:legalEntityIdentifier a owl:DatatypeProperty ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "Legal Entity Identifier (LEI) per ISO 17442 — a 20-character alphanumeric code uniquely identifying the legal entity." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:taxIdentificationNumber a owl:DatatypeProperty ;
    rdfs:label "tax identification number" ;
    rdfs:comment "Tax identification number assigned by the country of registration (VAT number, EIN, etc.)." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:registrationCountry a owl:DatatypeProperty ;
    rdfs:label "registration country" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code of the party's country of legal registration." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:registrationNumber a owl:DatatypeProperty ;
    rdfs:label "registration number" ;
    rdfs:comment "Company registration number in the country of registration (e.g., Companies House number, KVK number)." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .

:dunsNumber a owl:DatatypeProperty ;
    rdfs:label "DUNS number" ;
    rdfs:comment "Dun & Bradstreet D-U-N-S number — a 9-digit identifier for business entities." ;
    rdfs:domain :TradeParty ;
    rdfs:range xsd:string .
