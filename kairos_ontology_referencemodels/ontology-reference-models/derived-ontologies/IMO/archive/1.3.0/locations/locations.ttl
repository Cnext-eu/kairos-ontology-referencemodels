@prefix : <https://www.kairosflow.ai/ont/imo/locations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/imo/locations> a owl:Ontology ;
    dcterms:title "IMO Locations Ontology" ;
    dcterms:description """Maritime location and navigational area domain ontology aligned with the IMO Compendium.

    Defines ports, anchorages, berths, VTS zones, pilot boarding places,
    port approaches, and traffic separation schemes. Supports the UN/LOCODE location identification
    system and IMO requirements for vessel traffic management and port operations.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    dcterms:source "IMO Compendium data set, FAL Convention, COLREG Rule 10, Resolution A.857(20)" ;
    rdfs:seeAlso <https://imocompendium.imo.org/public/IMO-Compendium/Current> .

#################################################################
#    Classes
#################################################################

:MaritimeLocation a owl:Class ;
    rdfs:label "Maritime Location" ;
    rdfs:comment """A geographically defined point, area, or zone relevant to maritime navigation,
    port operations, or vessel traffic management.""" .

:Port a owl:Class ;
    rdfs:label "Port" ;
    rdfs:comment """A maritime port facility with infrastructure for the loading, unloading, and
    transit of cargo and passengers. Identified by a UN/LOCODE.

    IMO: A port encompasses all terminals, anchorages, and approaches within its jurisdiction.""" ;
    rdfs:subClassOf :MaritimeLocation ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :unlocode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/dcsa/locations#Location> .

:Anchorage a owl:Class ;
    rdfs:label "Anchorage" ;
    rdfs:comment """A designated area within port waters or its approaches where vessels may anchor
    while awaiting berth availability, pilotage, or port clearance.

    Anchorages are charted and may be assigned by the port authority or VTS.

    Properties: anchorageName, anchorageType, anchorageMaxVesselSize, anchorageHoldingGround.

    Source: SOLAS V/12, IMO Resolution A.857(20) VTS Guidelines.""" ;
    rdfs:subClassOf :MaritimeLocation .

:VTSZone a owl:Class ;
    rdfs:label "VTS Zone" ;
    rdfs:comment """A Vessel Traffic Service zone — an area of sea monitored and managed by a
    shore-based VTS authority in accordance with IMO Resolution A.857(20).

    Vessels entering a VTS zone must report to the VTS centre and comply with
    traffic management instructions.

    Properties: vtsAuthority, vtsChannel, vtsReportingRequirements, vtsServiceArea.

    Source: SOLAS V/12, IMO Resolution A.857(20) Guidelines for VTS.""" ;
    rdfs:subClassOf :MaritimeLocation ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :vtsAuthority ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:PilotBoardingPlace a owl:Class ;
    rdfs:label "Pilot Boarding Place" ;
    rdfs:comment """The designated geographical position where a maritime pilot boards or disembarks
    a vessel. Defined by coordinates and published in nautical publications (Admiralty Pilot).

    Properties: pilotBoardingProcedure, pilotBoardingTime, pilotLadderRequired.

    Source: SOLAS V/10, IMO Resolution A.960(23) Pilotage Procedures.""" ;
    rdfs:subClassOf :MaritimeLocation ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :latitude ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :longitude ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Berth a owl:Class ;
    rdfs:label "Berth" ;
    rdfs:comment """A designated location at a port terminal where a vessel is moored for cargo
    operations, passenger embarkation/disembarkation, or lay-by.

    Berth specifications include length, depth alongside, and available equipment.""" ;
    rdfs:subClassOf :MaritimeLocation ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :berthName ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:PortApproach a owl:Class ;
    rdfs:label "Port Approach" ;
    rdfs:comment """The navigable waterway and channel system leading from the open sea to the
    port's inner harbour. Includes approach channels, turning basins, and
    fairways, each with defined depth and width characteristics.""" ;
    rdfs:subClassOf :MaritimeLocation .

:TrafficSeparationScheme a owl:Class ;
    rdfs:label "Traffic Separation Scheme" ;
    rdfs:comment """A routing measure adopted by IMO under COLREG Rule 10 to separate opposing
    streams of vessel traffic using traffic lanes, separation zones, and inshore
    traffic zones. Reduces the risk of collision in congested or convergent areas.

    Properties: tssSchemeType, tssTrafficLaneDirection, tssSeparationZoneWidth.

    Source: COLREGS 1972 Rule 10, IMO Resolution A.572(15) General Provisions on Routing.""" ;
    rdfs:subClassOf :MaritimeLocation .

#################################################################
#    Object Properties
#################################################################

:hasAnchorage a owl:ObjectProperty ;
    rdfs:label "has anchorage" ;
    rdfs:comment "Associates a port with one of its designated anchorage areas." ;
    rdfs:domain :Port ;
    rdfs:range :Anchorage .

:hasBerth a owl:ObjectProperty ;
    rdfs:label "has berth" ;
    rdfs:comment "Associates a port with one of its berths." ;
    rdfs:domain :Port ;
    rdfs:range :Berth .

:hasPortApproach a owl:ObjectProperty ;
    rdfs:label "has port approach" ;
    rdfs:comment "Associates a port with its approach channel system." ;
    rdfs:domain :Port ;
    rdfs:range :PortApproach .

:hasPilotBoardingPlace a owl:ObjectProperty ;
    rdfs:label "has pilot boarding place" ;
    rdfs:comment "Associates a port with its designated pilot boarding place." ;
    rdfs:domain :Port ;
    rdfs:range :PilotBoardingPlace .

:hasVTSZone a owl:ObjectProperty ;
    rdfs:label "has VTS zone" ;
    rdfs:comment "Associates a port or port approach with a VTS zone covering the area." ;
    rdfs:domain :Port ;
    rdfs:range :VTSZone .

:hasTrafficSeparationScheme a owl:ObjectProperty ;
    rdfs:label "has traffic separation scheme" ;
    rdfs:comment "Associates a port approach or VTS zone with an applicable traffic separation scheme." ;
    rdfs:domain :PortApproach ;
    rdfs:range :TrafficSeparationScheme .

:locatedWithin a owl:ObjectProperty ;
    rdfs:label "located within" ;
    rdfs:comment "Indicates that a maritime location is geographically within another location." ;
    rdfs:domain :MaritimeLocation ;
    rdfs:range :MaritimeLocation .

#################################################################
#    Datatype Properties
#################################################################

:unlocode a owl:DatatypeProperty ;
    rdfs:label "UN/LOCODE" ;
    rdfs:comment "The UN/LOCODE (five-character code) identifying a port or location (e.g., 'NLRTM' for Rotterdam)." ;
    rdfs:domain :Port ;
    rdfs:range xsd:string .

:portName a owl:DatatypeProperty ;
    rdfs:label "port name" ;
    rdfs:comment "The common name of the port." ;
    rdfs:domain :Port ;
    rdfs:range xsd:string .

:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "WGS 84 latitude in decimal degrees." ;
    rdfs:domain :MaritimeLocation ;
    rdfs:range xsd:decimal .

:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "WGS 84 longitude in decimal degrees." ;
    rdfs:domain :MaritimeLocation ;
    rdfs:range xsd:decimal .

:berthName a owl:DatatypeProperty ;
    rdfs:label "berth name" ;
    rdfs:comment "The designation or name of a berth at a terminal." ;
    rdfs:domain :Berth ;
    rdfs:range xsd:string .

:berthLength a owl:DatatypeProperty ;
    rdfs:label "berth length" ;
    rdfs:comment "The length of the berth in metres." ;
    rdfs:domain :Berth ;
    rdfs:range xsd:decimal .

:depthAlongside a owl:DatatypeProperty ;
    rdfs:label "depth alongside" ;
    rdfs:comment "The charted depth alongside the berth at chart datum, in metres." ;
    rdfs:domain :Berth ;
    rdfs:range xsd:decimal .

:channelDepth a owl:DatatypeProperty ;
    rdfs:label "channel depth" ;
    rdfs:comment "The maintained depth of a port approach channel, in metres." ;
    rdfs:domain :PortApproach ;
    rdfs:range xsd:decimal .

:channelWidth a owl:DatatypeProperty ;
    rdfs:label "channel width" ;
    rdfs:comment "The width of a port approach channel, in metres." ;
    rdfs:domain :PortApproach ;
    rdfs:range xsd:decimal .

:vtsAuthority a owl:DatatypeProperty ;
    rdfs:label "VTS authority" ;
    rdfs:comment "The name of the authority operating the Vessel Traffic Service." ;
    rdfs:domain :VTSZone ;
    rdfs:range xsd:string .

:vtsChannel a owl:DatatypeProperty ;
    rdfs:label "VTS channel" ;
    rdfs:comment "The VHF radio channel used for communication with the VTS centre." ;
    rdfs:domain :VTSZone ;
    rdfs:range xsd:string .

:anchorageName a owl:DatatypeProperty ;
    rdfs:label "anchorage name" ;
    rdfs:comment "The designated name or code of the anchorage area." ;
    rdfs:domain :Anchorage ;
    rdfs:range xsd:string .

:maxDraftAllowed a owl:DatatypeProperty ;
    rdfs:label "maximum draft allowed" ;
    rdfs:comment "The maximum vessel draft permitted in this location, in metres." ;
    rdfs:domain :MaritimeLocation ;
    rdfs:range xsd:decimal .

#################################################################
#    Environmental Zone Classes
#################################################################

:EmissionControlArea a owl:Class ;
    rdfs:label "Emission Control Area" ;
    rdfs:comment """A designated sea area where stricter controls on emissions from ships apply.

    MARPOL Annex VI Regulation 14: ECAs currently designated for SOx include the
    Baltic Sea, North Sea, North American, and US Caribbean areas. NOx ECAs include
    the North American and US Caribbean areas.

    Within ECAs, fuel sulphur content must not exceed 0.10% (vs. 0.50% globally).

    Properties: ecaDesignation, ecaName, ecaSulphurLimit, ecaApplicableAnnex.

    Source: MARPOL Annex VI Regulation 14.""" ;
    rdfs:subClassOf :MaritimeLocation ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :ecaDesignation ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:MARPOLSpecialArea a owl:Class ;
    rdfs:label "MARPOL Special Area" ;
    rdfs:comment """A sea area designated under MARPOL where the adoption of special mandatory
    methods for the prevention of sea pollution is required.

    Special areas exist under MARPOL Annexes I (oil), II (NLS), IV (sewage),
    V (garbage), and VI (SOx). Examples include the Mediterranean Sea,
    Baltic Sea, Black Sea, Red Sea, and Antarctic area.

    Properties: specialAreaAnnex, specialAreaName, specialAreaDischargeRestrictions, specialAreaEffectiveDate.

    Source: MARPOL 73/78, Annexes I-VI Special Area designations.""" ;
    rdfs:subClassOf :MaritimeLocation .

:PortReceptionFacility a owl:Class ;
    rdfs:label "Port Reception Facility" ;
    rdfs:comment """A shore-based facility for receiving ship-generated waste and cargo residues.

    MARPOL requires all ports to provide adequate reception facilities for the wastes
    covered by its annexes. Ships must be able to deliver waste before departing.

    Properties: wasteTypesAccepted, prfFacilityCapacity, prfNotificationRequired.

    Source: MARPOL Annexes I/IV/V/VI, Regulation on Port Reception Facilities.""" ;
    rdfs:subClassOf :MaritimeLocation .

# Environmental zone properties

:ecaDesignation a owl:DatatypeProperty ;
    rdfs:label "ECA designation" ;
    rdfs:comment "Designation type of the emission control area (SOX, NOX, SOX_NOX, PARTICULATE)." ;
    rdfs:domain :EmissionControlArea ;
    rdfs:range xsd:string .

:ecaName a owl:DatatypeProperty ;
    rdfs:label "ECA name" ;
    rdfs:comment "Name of the emission control area (e.g., BALTIC_SEA, NORTH_SEA, NORTH_AMERICAN, US_CARIBBEAN)." ;
    rdfs:domain :EmissionControlArea ;
    rdfs:range xsd:string .

:specialAreaAnnex a owl:DatatypeProperty ;
    rdfs:label "special area MARPOL annex" ;
    rdfs:comment "The MARPOL annex under which the special area is designated (I, II, IV, V, VI)." ;
    rdfs:domain :MARPOLSpecialArea ;
    rdfs:range xsd:string .

:specialAreaName a owl:DatatypeProperty ;
    rdfs:label "special area name" ;
    rdfs:comment "Name of the MARPOL special area (e.g., MEDITERRANEAN, BALTIC, BLACK_SEA, RED_SEA, ANTARCTIC)." ;
    rdfs:domain :MARPOLSpecialArea ;
    rdfs:range xsd:string .

:wasteTypesAccepted a owl:DatatypeProperty ;
    rdfs:label "waste types accepted" ;
    rdfs:comment "Types of ship-generated waste the port reception facility accepts (OIL, GARBAGE, SEWAGE, NLS, EXHAUST)." ;
    rdfs:domain :PortReceptionFacility ;
    rdfs:range xsd:string .

#################################################################
#    Datatype Properties — Enrichment (MARPOL / SOLAS / COLREGS)
#################################################################

:anchorageType a owl:DatatypeProperty ;
    rdfs:label "anchorage type" ;
    rdfs:comment "Type of anchorage (e.g., 'Designated', 'Emergency', 'Quarantine', 'Deep water'). SOLAS V/12." ;
    rdfs:domain :Anchorage ;
    rdfs:range xsd:string .

:anchorageMaxVesselSize a owl:DatatypeProperty ;
    rdfs:label "anchorage max vessel size" ;
    rdfs:comment "Maximum vessel size (LOA in metres) permitted at the anchorage. Port authority designation." ;
    rdfs:domain :Anchorage ;
    rdfs:range xsd:decimal .

:anchorageHoldingGround a owl:DatatypeProperty ;
    rdfs:label "anchorage holding ground" ;
    rdfs:comment "Description of the seabed holding ground type (e.g., 'Mud', 'Sand', 'Clay'). Charted anchorage information." ;
    rdfs:domain :Anchorage ;
    rdfs:range xsd:string .

:vtsReportingRequirements a owl:DatatypeProperty ;
    rdfs:label "VTS reporting requirements" ;
    rdfs:comment "Description of vessel reporting requirements upon entering the VTS zone. SOLAS V/12, Resolution A.857(20)." ;
    rdfs:domain :VTSZone ;
    rdfs:range xsd:string .

:vtsServiceArea a owl:DatatypeProperty ;
    rdfs:label "VTS service area" ;
    rdfs:comment "Description of the geographic scope of the VTS service area. Resolution A.857(20)." ;
    rdfs:domain :VTSZone ;
    rdfs:range xsd:string .

:pilotBoardingProcedure a owl:DatatypeProperty ;
    rdfs:label "pilot boarding procedure" ;
    rdfs:comment "Description of the pilot boarding procedure at this boarding place. SOLAS V/10." ;
    rdfs:domain :PilotBoardingPlace ;
    rdfs:range xsd:string .

:pilotBoardingTime a owl:DatatypeProperty ;
    rdfs:label "pilot boarding time" ;
    rdfs:comment "Scheduled or expected time for pilot boarding operations. SOLAS V/10." ;
    rdfs:domain :PilotBoardingPlace ;
    rdfs:range xsd:dateTime .

:pilotLadderRequired a owl:DatatypeProperty ;
    rdfs:label "pilot ladder required" ;
    rdfs:comment "Whether a pilot ladder is required for boarding at this location. SOLAS V/10, Regulation 17." ;
    rdfs:domain :PilotBoardingPlace ;
    rdfs:range xsd:boolean .

:tssSchemeType a owl:DatatypeProperty ;
    rdfs:label "TSS scheme type" ;
    rdfs:comment "Type of traffic separation scheme (e.g., 'Roundabout', 'Routing', 'Precautionary area'). COLREGS Rule 10." ;
    rdfs:domain :TrafficSeparationScheme ;
    rdfs:range xsd:string .

:tssTrafficLaneDirection a owl:DatatypeProperty ;
    rdfs:label "TSS traffic lane direction" ;
    rdfs:comment "Description of the traffic lane direction(s) in the TSS. COLREGS Rule 10." ;
    rdfs:domain :TrafficSeparationScheme ;
    rdfs:range xsd:string .

:tssSeparationZoneWidth a owl:DatatypeProperty ;
    rdfs:label "TSS separation zone width" ;
    rdfs:comment "Width of the separation zone between opposing traffic lanes, in nautical miles. COLREGS Rule 10." ;
    rdfs:domain :TrafficSeparationScheme ;
    rdfs:range xsd:decimal .

:ecaSulphurLimit a owl:DatatypeProperty ;
    rdfs:label "ECA sulphur limit" ;
    rdfs:comment "Maximum fuel sulphur content permitted within the ECA (e.g., '0.10%' for SOx ECAs). MARPOL Annex VI Regulation 14.4." ;
    rdfs:domain :EmissionControlArea ;
    rdfs:range xsd:string .

:ecaApplicableAnnex a owl:DatatypeProperty ;
    rdfs:label "ECA applicable annex" ;
    rdfs:comment "MARPOL annex number under which the ECA is designated (e.g., 'VI'). MARPOL Annex VI Regulation 14." ;
    rdfs:domain :EmissionControlArea ;
    rdfs:range xsd:string .

:specialAreaDischargeRestrictions a owl:DatatypeProperty ;
    rdfs:label "special area discharge restrictions" ;
    rdfs:comment "Description of the discharge restrictions applying within the MARPOL special area. MARPOL Annexes I-VI." ;
    rdfs:domain :MARPOLSpecialArea ;
    rdfs:range xsd:string .

:specialAreaEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "special area effective date" ;
    rdfs:comment "Date when the special area designation became effective. MARPOL Annexes I-VI." ;
    rdfs:domain :MARPOLSpecialArea ;
    rdfs:range xsd:date .

:prfFacilityCapacity a owl:DatatypeProperty ;
    rdfs:label "PRF facility capacity" ;
    rdfs:comment "Description of the waste reception capacity of the facility. MARPOL Annexes I/IV/V/VI." ;
    rdfs:domain :PortReceptionFacility ;
    rdfs:range xsd:string .

:prfNotificationRequired a owl:DatatypeProperty ;
    rdfs:label "PRF notification required" ;
    rdfs:comment "Whether advance notification is required before delivering waste to the PRF. MARPOL Annex V Regulation 7, Annex VI Regulation 17." ;
    rdfs:domain :PortReceptionFacility ;
    rdfs:range xsd:boolean .
