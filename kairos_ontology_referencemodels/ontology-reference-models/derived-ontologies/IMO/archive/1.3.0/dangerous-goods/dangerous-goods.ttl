@prefix : <https://www.kairosflow.ai/ont/imo/dangerous-goods#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/imo/dangerous-goods> a owl:Ontology ;
    dcterms:title "IMO Dangerous Goods Ontology" ;
    dcterms:description """Dangerous goods classification, declaration, and transport domain ontology
    aligned with the IMDG Code and the IMO Compendium.

    Covers UN number identification, hazard classes, packing groups, stowage and segregation rules,
    and the Dangerous Goods Declaration (IMO FAL Form 7). Supports compliance with SOLAS Chapter VII
    and MARPOL Annex III for the safe carriage of dangerous goods by sea.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    dcterms:source "IMDG Code (Amendment 41-22), SOLAS Chapter VII, IMO Compendium data set" ;
    rdfs:seeAlso <https://imocompendium.imo.org/public/IMO-Compendium/Current> .

#################################################################
#    Classes
#################################################################

:DangerousGoodsItem a owl:Class ;
    rdfs:label "Dangerous Goods Item" ;
    rdfs:comment """An item or substance classified as dangerous goods under the IMDG Code.

    Each DG item must be identified by its UN number and assigned to a hazard class
    for proper handling, stowage, and segregation during maritime transport.""" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasUNNumber ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasHazardClass ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:HazardClass a owl:Class ;
    rdfs:label "Hazard Class" ;
    rdfs:comment """One of the nine hazard classes (and their divisions) defined by the IMDG Code,
    e.g., Class 1 Explosives, Class 3 Flammable Liquids, Class 7 Radioactive Material.

    Determines applicable transport, stowage, and emergency response requirements.

    Properties: hasSegregationRule, hazardClassCode, hazardClassName, hazardClassDivision.

    Source: IMDG Code (Amendment 41-22) Part 2, Dangerous Goods List.""" .

:UNNumber a owl:Class ;
    rdfs:label "UN Number" ;
    rdfs:comment """A four-digit identifier assigned by the UN Committee of Experts to a dangerous
    substance or article (e.g., UN 1203 for gasoline). Used universally for DG identification
    across all transport modes.

    Properties: unNumberValue, unProperShippingName.

    Source: UN Recommendations on the Transport of Dangerous Goods, IMDG Code Dangerous Goods List.""" .

:PackingGroup a owl:Class ;
    rdfs:label "Packing Group" ;
    rdfs:comment """A classification indicating the degree of danger presented by a substance.

    Packing Group I — high danger; Packing Group II — medium danger;
    Packing Group III — low danger. Determines packaging requirements.

    Properties: packingGroupCode, packingGroupDangerLevel.

    Source: IMDG Code Part 2, UN Recommendations on the Transport of Dangerous Goods.""" .

:FlashPoint a owl:Class ;
    rdfs:label "Flash Point" ;
    rdfs:comment """The lowest temperature at which a substance gives off sufficient vapour to
    form an ignitable mixture with air. Critical for classification of flammable liquids
    under the IMDG Code.

    Properties: flashPointValue, flashPointTestMethod, flashPointUnit.

    Source: IMDG Code Part 2, Class 3 Flammable Liquids, 2.3.1.""" .

:EmergencySchedule a owl:Class ;
    rdfs:label "Emergency Schedule" ;
    rdfs:comment """The EmS (Emergency Schedule) number assigned to dangerous goods specifying
    fire-fighting and spillage procedures. Formatted as F-x (fire) and S-x (spillage),
    as per the IMO/ILO/UNECE guidelines.

    Properties: emsFireSchedule, emsSpillageSchedule, emsScheduleTitle.

    Source: IMDG Code Supplement, EmS Guide (Emergency Response Procedures for Ships
    Carrying Dangerous Goods).""" .

:SegregationRule a owl:Class ;
    rdfs:label "Segregation Rule" ;
    rdfs:comment """A rule specifying the required physical separation between incompatible
    dangerous goods classes during stowage aboard a vessel.

    Defined in IMDG Code Chapter 7.2 with categories: away from, separated from,
    separated by a complete compartment from, etc.

    Properties: segregationTerm, segregationDescription.

    Source: IMDG Code Chapter 7.2, Segregation Table.""" .

:StowageCategory a owl:Class ;
    rdfs:label "Stowage Category" ;
    rdfs:comment """A stowage category code (A through E) assigned by the IMDG Code indicating
    whether dangerous goods may be stowed on deck, under deck, or have other stowage restrictions.

    Properties: stowageCategoryCode, stowageCategoryDescription.

    Source: IMDG Code Part 7, Chapter 7.1, Stowage and Segregation.""" .

:EmergencyContact a owl:Class ;
    rdfs:label "Emergency Contact" ;
    rdfs:comment """A designated 24-hour emergency contact point for dangerous goods incidents,
    as required by IMDG Code section 5.4.1.7. Typically provided by the shipper or
    a contracted emergency response service.

    Properties: contactName, contactPhone, contactOrganization, contactAvailable24h.

    Source: IMDG Code Section 5.4.1.7, Emergency Response Information.""" .

:DGDeclaration a owl:Class ;
    rdfs:label "Dangerous Goods Declaration" ;
    rdfs:comment """The Dangerous Goods Declaration (IMO FAL Form 7 / Multimodal Dangerous Goods Form)
    listing all dangerous goods aboard or to be loaded.

    Must accompany every consignment of dangerous goods and include proper shipping name,
    UN number, class, packing group, and emergency information.""" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :declaresItem ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

#################################################################
#    Object Properties
#################################################################

:hasUNNumber a owl:ObjectProperty ;
    rdfs:label "has UN number" ;
    rdfs:comment "Associates a dangerous goods item with its UN number." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :UNNumber .

:hasHazardClass a owl:ObjectProperty ;
    rdfs:label "has hazard class" ;
    rdfs:comment "Associates a dangerous goods item with its primary hazard class." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :HazardClass .

:hasPackingGroup a owl:ObjectProperty ;
    rdfs:label "has packing group" ;
    rdfs:comment "Associates a dangerous goods item with its packing group." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :PackingGroup .

:hasFlashPoint a owl:ObjectProperty ;
    rdfs:label "has flash point" ;
    rdfs:comment "Associates a dangerous goods item with its flash point measurement." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :FlashPoint .

:hasEmergencySchedule a owl:ObjectProperty ;
    rdfs:label "has emergency schedule" ;
    rdfs:comment "Associates a dangerous goods item with its EmS fire and spillage schedules." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :EmergencySchedule .

:hasSegregationRule a owl:ObjectProperty ;
    rdfs:label "has segregation rule" ;
    rdfs:comment "Associates a hazard class with a segregation rule for incompatible classes." ;
    rdfs:domain :HazardClass ;
    rdfs:range :SegregationRule .

:hasStowageCategory a owl:ObjectProperty ;
    rdfs:label "has stowage category" ;
    rdfs:comment "Associates a dangerous goods item with its assigned stowage category." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range :StowageCategory .

:hasEmergencyContact a owl:ObjectProperty ;
    rdfs:label "has emergency contact" ;
    rdfs:comment "Associates a DG declaration or item with a 24-hour emergency contact." ;
    rdfs:domain :DGDeclaration ;
    rdfs:range :EmergencyContact .

:declaresItem a owl:ObjectProperty ;
    rdfs:label "declares item" ;
    rdfs:comment "Associates a DG declaration with a dangerous goods item listed therein." ;
    rdfs:domain :DGDeclaration ;
    rdfs:range :DangerousGoodsItem .

#################################################################
#    Datatype Properties
#################################################################

:unNumberValue a owl:DatatypeProperty ;
    rdfs:label "UN number value" ;
    rdfs:comment "The four-digit UN number as a string (e.g., '1203')." ;
    rdfs:domain :UNNumber ;
    rdfs:range xsd:string .

:hazardClassCode a owl:DatatypeProperty ;
    rdfs:label "hazard class code" ;
    rdfs:comment "The IMDG hazard class and division code (e.g., '3', '2.1', '6.1')." ;
    rdfs:domain :HazardClass ;
    rdfs:range xsd:string .

:subsidiaryRisk a owl:DatatypeProperty ;
    rdfs:label "subsidiary risk" ;
    rdfs:comment "A subsidiary hazard class code for a DG item with multiple risks." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range xsd:string .

:packingGroupCode a owl:DatatypeProperty ;
    rdfs:label "packing group code" ;
    rdfs:comment "The packing group designation: 'I', 'II', or 'III'." ;
    rdfs:domain :PackingGroup ;
    rdfs:range xsd:string .

:flashPointValue a owl:DatatypeProperty ;
    rdfs:label "flash point value" ;
    rdfs:comment "Flash point temperature in degrees Celsius." ;
    rdfs:domain :FlashPoint ;
    rdfs:range xsd:decimal .

:properShippingName a owl:DatatypeProperty ;
    rdfs:label "proper shipping name" ;
    rdfs:comment "The proper shipping name as specified in the IMDG Code Dangerous Goods List." ;
    rdfs:domain :DangerousGoodsItem ;
    rdfs:range xsd:string .

:emsFireSchedule a owl:DatatypeProperty ;
    rdfs:label "EmS fire schedule" ;
    rdfs:comment "The EmS fire-fighting schedule code (e.g., 'F-E')." ;
    rdfs:domain :EmergencySchedule ;
    rdfs:range xsd:string .

:emsSpillageSchedule a owl:DatatypeProperty ;
    rdfs:label "EmS spillage schedule" ;
    rdfs:comment "The EmS spillage schedule code (e.g., 'S-D')." ;
    rdfs:domain :EmergencySchedule ;
    rdfs:range xsd:string .

:declarationDate a owl:DatatypeProperty ;
    rdfs:label "declaration date" ;
    rdfs:comment "The date the DG declaration was issued." ;
    rdfs:domain :DGDeclaration ;
    rdfs:range xsd:date .

:contactName a owl:DatatypeProperty ;
    rdfs:label "contact name" ;
    rdfs:comment "Name of the emergency contact person or organization." ;
    rdfs:domain :EmergencyContact ;
    rdfs:range xsd:string .

:contactPhone a owl:DatatypeProperty ;
    rdfs:label "contact phone" ;
    rdfs:comment "24-hour telephone number of the emergency contact." ;
    rdfs:domain :EmergencyContact ;
    rdfs:range xsd:string .

#################################################################
#    Datatype Properties — Enrichment (IMDG Code)
#################################################################

:hazardClassName a owl:DatatypeProperty ;
    rdfs:label "hazard class name" ;
    rdfs:comment "Name of the IMDG hazard class (e.g., 'Flammable Liquids', 'Corrosive Substances')." ;
    rdfs:domain :HazardClass ;
    rdfs:range xsd:string .

:hazardClassDivision a owl:DatatypeProperty ;
    rdfs:label "hazard class division" ;
    rdfs:comment "Subdivision number of the hazard class (e.g., '2.1' for Flammable Gas, '6.2' for Infectious Substances)." ;
    rdfs:domain :HazardClass ;
    rdfs:range xsd:string .

:unProperShippingName a owl:DatatypeProperty ;
    rdfs:label "UN proper shipping name" ;
    rdfs:comment "The proper shipping name associated with this UN number as listed in the IMDG Code Dangerous Goods List (Column 2)." ;
    rdfs:domain :UNNumber ;
    rdfs:range xsd:string .

:packingGroupDangerLevel a owl:DatatypeProperty ;
    rdfs:label "packing group danger level" ;
    rdfs:comment "Textual description of the danger level (e.g., 'high danger', 'medium danger', 'low danger')." ;
    rdfs:domain :PackingGroup ;
    rdfs:range xsd:string .

:flashPointTestMethod a owl:DatatypeProperty ;
    rdfs:label "flash point test method" ;
    rdfs:comment "Test method used to determine the flash point (e.g., 'Closed cup' / 'Open cup'). IMDG Code 2.3.1." ;
    rdfs:domain :FlashPoint ;
    rdfs:range xsd:string .

:flashPointUnit a owl:DatatypeProperty ;
    rdfs:label "flash point unit" ;
    rdfs:comment "Unit of measurement for the flash point temperature (e.g., '°C')." ;
    rdfs:domain :FlashPoint ;
    rdfs:range xsd:string .

:emsScheduleTitle a owl:DatatypeProperty ;
    rdfs:label "EmS schedule title" ;
    rdfs:comment "Title of the EmS schedule (e.g., 'Fire Schedule F-E, Engine Room Cargo Space')" ;
    rdfs:domain :EmergencySchedule ;
    rdfs:range xsd:string .

:segregationTerm a owl:DatatypeProperty ;
    rdfs:label "segregation term" ;
    rdfs:comment "The segregation term code: '1' (away from), '2' (separated from), '3' (separated by a complete compartment from), '4' (separated longitudinally by an intervening complete compartment from). IMDG Code 7.2." ;
    rdfs:domain :SegregationRule ;
    rdfs:range xsd:string .

:segregationDescription a owl:DatatypeProperty ;
    rdfs:label "segregation description" ;
    rdfs:comment "Human-readable description of the segregation requirement. IMDG Code Chapter 7.2 Segregation Table." ;
    rdfs:domain :SegregationRule ;
    rdfs:range xsd:string .

:stowageCategoryCode a owl:DatatypeProperty ;
    rdfs:label "stowage category code" ;
    rdfs:comment "Single-letter stowage category code (A-E). IMDG Code 7.1." ;
    rdfs:domain :StowageCategory ;
    rdfs:range xsd:string .

:stowageCategoryDescription a owl:DatatypeProperty ;
    rdfs:label "stowage category description" ;
    rdfs:comment "Description of the stowage category (e.g., 'On deck only', 'On deck or under deck'). IMDG Code 7.1." ;
    rdfs:domain :StowageCategory ;
    rdfs:range xsd:string .

:contactOrganization a owl:DatatypeProperty ;
    rdfs:label "contact organization" ;
    rdfs:comment "Name of the emergency response organization providing the 24-hour service. IMDG Code 5.4.1.7." ;
    rdfs:domain :EmergencyContact ;
    rdfs:range xsd:string .

:contactAvailable24h a owl:DatatypeProperty ;
    rdfs:label "contact available 24h" ;
    rdfs:comment "Whether the emergency contact is available 24 hours a day. IMDG Code 5.4.1.7." ;
    rdfs:domain :EmergencyContact ;
    rdfs:range xsd:boolean .
