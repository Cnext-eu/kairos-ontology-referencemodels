{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kairosflow.ai/schema/logistics/canonical-registry.schema.json",
  "title": "Logistics canonical class registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "accelerator_version", "concepts"],
  "properties": {
    "format_version": {"const": "1.0"},
    "accelerator_version": {"$ref": "#/$defs/semver"},
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class_uri",
        "authority",
        "grain",
        "identity",
        "lifecycle",
        "disposition",
        "evidence",
        "evidence_basis",
        "confidence",
        "maturity",
        "first_slice"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "class_uri": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "grain": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": ["approved", "deferred", "rejected", "unresolved"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_basis": {
          "description": "What kind of evidence justifies this concept, independent of its disposition. 'implementation' evidence (a client hub attestation) may raise, corroborate, or force re-review of a concept, but per validate_logistics_blueprint.py it can never by itself justify disposition: approved — that requires standard, pack-consistency, or analysis evidence.",
          "enum": ["standard", "pack-consistency", "implementation", "analysis"]
        },
        "confidence": {"enum": ["low", "medium", "high"]},
        "maturity": {"enum": ["experimental", "preview", "stable"]},
        "first_slice": {"type": "boolean"},
        "standards": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "implementations": {
          "description": "Ids of implementation attestations (evidence/attestations/<id>.yaml) that bear on this concept. Informational only — see evidence_basis.",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
