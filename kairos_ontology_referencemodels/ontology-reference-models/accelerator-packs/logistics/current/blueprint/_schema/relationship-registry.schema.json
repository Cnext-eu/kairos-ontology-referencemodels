{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kairosflow.ai/schema/logistics/relationship-registry.schema.json",
  "title": "Logistics relationship registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "accelerator_version", "relationships"],
  "properties": {
    "format_version": {"const": "1.0"},
    "accelerator_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "property_uri",
          "domain_concept",
          "range_concept",
          "direction",
          "cardinality",
          "temporal_semantics",
          "disposition",
          "evidence",
          "confidence",
          "maturity",
          "first_slice"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "property_uri": {"type": "string", "minLength": 1},
          "domain_concept": {"type": "string", "minLength": 1},
          "range_concept": {"type": "string", "minLength": 1},
          "direction": {"enum": ["forward", "inverse", "bidirectional"]},
          "cardinality": {"type": "string", "pattern": "^(0|1|n)\\.\\.(1|n)$"},
          "temporal_semantics": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["approved", "deferred", "rejected", "unresolved"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "maturity": {"enum": ["experimental", "preview", "stable"]},
          "first_slice": {"type": "boolean"}
        }
      }
    }
  }
}
