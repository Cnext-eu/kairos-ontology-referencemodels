<https://www.kairosflow.ai/ont/iso4217> a owl:Ontology ;
    rdfs:label "ISO 4217 currency codes" ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:source <https://www.six-group.com/dam/download/financial-information/data-center/iso-currrency/lists/list-one.xml>,
        <https://www.six-group.com/dam/download/financial-information/data-center/iso-currrency/lists/list-three.xml> ;
    rdfs:comment "ISO 4217 currency and fund codes from SIX, the ISO 4217 maintenance agency: list one (current, published 2026-09-17) and list three (historic, published 2026-01-01), retrieved 2026-10-18. Codes, names, numeric codes, minor units and withdrawal dates are copied from the XML unchanged; the IRIs are Kairos-minted because SIX publishes no RDF. Withdrawn codes are kept, owl:deprecated, with their withdrawal date. Generated by scripts/download_iso4217.py; do not hand-edit." ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/ISO4217/README.md> ;
    owl:versionInfo "2026-09-17" .

