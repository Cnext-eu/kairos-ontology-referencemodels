iso4217:isFund a owl:DatatypeProperty ;
    rdfs:label "is fund" ;
    rdfs:comment "True for fund codes (SIX IsFund), e.g. CHE, USN, XAD." ;
    rdfs:domain iso4217:CurrencyCode ;
    rdfs:range xsd:boolean .

iso4217:minorUnit a owl:DatatypeProperty ;
    rdfs:label "minor unit" ;
    rdfs:comment "Number of decimal places of the minor unit (absent where ISO 4217 says 'N.A.', e.g. XAU)." ;
    rdfs:domain iso4217:CurrencyCode ;
    rdfs:range xsd:integer .

iso4217:numericCode a owl:DatatypeProperty ;
    rdfs:label "numeric code" ;
    rdfs:comment "ISO 4217 numeric code, three digits with leading zeros kept (e.g. '008')." ;
    rdfs:domain iso4217:CurrencyCode ;
    rdfs:range xsd:string .

iso4217:withdrawalDate a owl:DatatypeProperty ;
    rdfs:label "withdrawal date" ;
    rdfs:comment "When ISO 4217 withdrew the code, as SIX writes it ('2025-03', '1989 to 1990'); the latest historic row." ;
    rdfs:domain iso4217:CurrencyCode ;
    rdfs:range xsd:string .

iso4217:CurrencyCode a owl:Class ;
    rdfs:label "ISO 4217 currency code" ;
    dcterms:description "ISO 4217 currency and fund codes, as maintained by SIX for ISO" ;
    dcterms:source <https://www.six-group.com/dam/download/financial-information/data-center/iso-currrency/lists/list-one.xml> ;
    rdfs:comment "A currency or fund in ISO 4217. The alphabetic code is in rdf:value and is the join key to source data; iso4217:numericCode and iso4217:minorUnit come from the same SIX row." ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/ISO4217/README.md> ;
    owl:versionInfo "2026-09-17" ;
    kairos-ext:isReferenceData true .

