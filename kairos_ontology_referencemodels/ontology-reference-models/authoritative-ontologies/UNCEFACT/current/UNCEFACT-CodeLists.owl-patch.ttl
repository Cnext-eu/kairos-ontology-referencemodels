unlcdv:countryCode a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( unlcdv:Subdivision unlcdv:UNLOCODE ) ] ;
    rdfs:range unlcdv:Country .

unlcdv:countrySubdivision a owl:ObjectProperty ;
    rdfs:domain unlcdv:UNLOCODE ;
    rdfs:range unlcdv:Subdivision .

unlcdv:functions a owl:ObjectProperty ;
    rdfs:domain unlcdv:UNLOCODE ;
    rdfs:range unlcdv:Function .

unlcdv:subdivisionType a owl:DatatypeProperty ;
    rdfs:domain unlcdv:Subdivision ;
    rdfs:range xsd:string .

<https://www.kairosflow.ai/ont/uncefact/code-lists> a owl:Ontology ;
    rdfs:label "UN/CEFACT code lists" ;
    dcterms:description "Reference data: standards-body code lists retrieved from https://vocabulary.uncefact.org/ on 2026-10-17 (per-document checksums in METADATA.txt). Refresh with scripts/download_uncefact_codelists.py; see the README linked by rdfs:seeAlso." ;
    dcterms:modified "2026-10-17"^^xsd:date ;
    dcterms:source unece: ;
    rdfs:comment "OWL typing for the vendored UN/CEFACT code lists. The upstream vocabulary declares each list as rdfs:Class, its codes as plain typed nodes, and its properties as rdf:Property; OWL-based consumers need owl:Class, owl:NamedIndividual, rdfs:label and OWL property types. Those triples are derived mechanically from the extract (rdfs:label is copied from rdfs:comment only where a code has no label); the rest is provenance (reference-data marker, snapshot version, source and README links). Generated by scripts/download_uncefact_codelists.py; do not hand-edit." ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/UNCEFACT/README.md> ;
    owl:imports <https://www.kairosflow.ai/ont/uncefact/code-lists-vendor-extract> ;
    owl:versionInfo "2026-10-17" .

unlcdv:Country a owl:Class ;
    dcterms:description "ISO 3166-1 alpha-2 country codes, as published with UN/LOCODE (UNECE Recommendation No. 16)" ;
    dcterms:source unece:unlocode-countries ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/UNCEFACT/README.md> ;
    owl:versionInfo "2026-10-17" ;
    kairos-ext:isReferenceData true .

unlcdv:Function a owl:Class ;
    dcterms:description "UN/LOCODE function classifiers (UNECE Recommendation No. 16)" ;
    dcterms:source unece:unlocode-functions ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/UNCEFACT/README.md> ;
    owl:versionInfo "2026-10-17" ;
    kairos-ext:isReferenceData true .

unlcdv:Subdivision a owl:Class ;
    dcterms:description "ISO 3166-2 country subdivision codes, as published with UN/LOCODE (UNECE Recommendation No. 16)" ;
    dcterms:source unece:unlocode-subdivisions ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/UNCEFACT/README.md> ;
    owl:versionInfo "2026-10-17" ;
    kairos-ext:isReferenceData true .

unlcdv:UNLOCODE a owl:Class .

