@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix unece: <https://vocabulary.uncefact.org/> .
@prefix unlcdv: <https://vocabulary.uncefact.org/unlocode-vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

unece:CurrencyCodeList a rdfs:Class ;
    rdfs:label "CurrencyCodeList" ;
    rdfs:comment "A character string used to represent a currency." .

unece:DeliveryTermsCodeList a rdfs:Class ;
    rdfs:label "DeliveryTermsCodeList" ;
    rdfs:comment "A character string used to represent delivery terms." .

unece:PackageTypeCodeList a rdfs:Class ;
    rdfs:label "PackageTypeCodeList" ;
    rdfs:comment "A character string used to replace or represent a type of package." .

unece:TransportModeCodeList a rdfs:Class ;
    rdfs:label "TransportModeCodeList" ;
    rdfs:comment "A character string used to represent a transport mode." .

unece:TransportMovementStageCodeList a rdfs:Class ;
    rdfs:label "TransportMovementStageCodeList" ;
    rdfs:comment "A character string used to represent the transport movement stage." .

unece:UnitMeasureCode a rdfs:Class ;
    rdfs:label "UnitMeasureCode" ;
    rdfs:comment "RDF Class for UnitMeasureType unit code type to define unit code values." .

unlcdv:Country a rdfs:Class ;
    rdfs:comment "The two-letter alphabetic country codes, adopted in International Standard ISO 3166-1." .

unlcdv:Function a rdfs:Class ;
    rdfs:comment "1-character function classifier code which identifies the existence of either a facility providing a connection with a specific mode of transport 1 or some other significant function not directly related to any mode of transport at this location" .

unlcdv:Subdivision a rdfs:Class ;
    rdfs:comment "Code for the administrative division of the country concerned (state, province, department, etc.)." .

unlcdv:UNLOCODE a rdfs:Class ;
    rdfs:comment "Identifies an administrative or economic area, relevant to international trade and transport, as defined by the competent national authority in each country." .

