rec28:TransportMeansTypeCode a owl:Class ;
    rdfs:label "Rec 28 type of means of transport" ;
    dcterms:description "UNECE Recommendation No. 28, Codes for Types of Means of Transport" ;
    dcterms:source <https://unece.org/trade/uncefact/cl-recommendations> ;
    rdfs:comment "A type of means of transport (vessel, train, road vehicle, aircraft, ...). The code is in rdf:value; its first digit is the UNECE Rec 19 transport mode (rec28:transportMode). Codes are hierarchical: skos:broader runs from a sub-type to its type (342 Van, light -> 34 Van)." ;
    rdfs:seeAlso <https://github.com/Cnext-eu/kairos-ontology-referencemodels/blob/main/kairos_ontology_referencemodels/ontology-reference-models/authoritative-ontologies/UNECE-Rec28/README.md> ;
    owl:versionInfo "Rev 4.2 (2018)" ;
    kairos-ext:isReferenceData true .

