@prefix : <https://www.kairosflow.ai/ont/imo/vessel-registry#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/imo/vessel-registry> a owl:Ontology ;
    dcterms:title "IMO Vessel Registry Ontology" ;
    dcterms:description """Vessel registration and identification domain ontology aligned with the IMO Compendium.

    Covers vessel identity (IMO number, MMSI, call sign), classification, flag state registration,
    and physical characteristics (tonnage, dimensions). Supports the IMO Ship Identification Number
    Scheme (Resolution A.1117(30)) and related SOLAS requirements.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-05-16"^^xsd:date ;
    owl:versionInfo "1.1.0" ;
    dcterms:source "IMO Compendium data set, SOLAS XI-1/3, Resolution A.1117(30), 1969 Tonnage Convention" ;
    rdfs:seeAlso <https://imocompendium.imo.org/public/IMO-Compendium/Current> .

#################################################################
#    Classes
#################################################################

:Vessel a owl:Class ;
    rdfs:label "Vessel" ;
    rdfs:comment """A ship or watercraft registered under a flag state and assigned a unique IMO number.

    IMO: Every vessel of 100 GT and above engaged in international voyages must carry
    a permanent IMO number as per SOLAS regulation XI-1/3.""" ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :imoNumber ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasVesselType ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasFlagState ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/dcsa/transport-call#VesselTransportCall> ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/mmt/transport-means#Vessel> .

:Fleet a owl:Class ;
    rdfs:label "Fleet" ;
    rdfs:comment """A collection of vessels operated or managed by a single entity.

    Used to group vessels under a common owner, operator, or manager for
    administrative and operational purposes.

    NOTE: This is a modeling convenience class — 'Fleet' is not a named entity in any
    IMO Compendium data set or FAL Convention instrument. Consider using a client-specific
    ontology for fleet management concepts.""" .

:IMONumber a owl:Class ;
    rdfs:label "IMO Number" ;
    rdfs:comment """A unique seven-digit identifier permanently assigned to a vessel by IHS Markit on behalf of IMO.

    The number remains unchanged upon transfer of flag and is prefixed with 'IMO'
    (e.g., IMO 9074729). Governed by IMO Resolution A.1117(30).""" .

:MMSI a owl:Class ;
    rdfs:label "MMSI" ;
    rdfs:comment """Maritime Mobile Service Identity — a nine-digit number used in digital
    selective calling (DSC), AIS, and GMDSS radio communications.

    Assigned by the flag state administration in accordance with ITU Radio Regulations.""" .

:CallSign a owl:Class ;
    rdfs:label "Call Sign" ;
    rdfs:comment """A unique radio call sign allocated to a vessel by its flag state for
    maritime communication purposes, in accordance with ITU Radio Regulations.""" .

:FlagState a owl:Class ;
    rdfs:label "Flag State" ;
    rdfs:comment """The state whose flag a vessel is entitled to fly. The flag state has
    jurisdiction and control over administrative, technical, and social matters
    aboard the vessel as per UNCLOS Article 94.""" .

:ClassSociety a owl:Class ;
    rdfs:label "Classification Society" ;
    rdfs:comment """An organization that establishes and maintains technical standards for the
    construction and operation of ships. Recognized classification societies act
    on behalf of flag states (e.g., Lloyd's Register, DNV, Bureau Veritas).""" .

:VesselType a owl:Class ;
    rdfs:label "Vessel Type" ;
    rdfs:comment """A classification of vessels by their design and intended purpose,
    such as bulk carrier, container ship, tanker, passenger vessel, or ro-ro cargo ship.

    Aligned with IMO vessel type codes used in FAL forms.""" .

:VesselCapacity a owl:Class ;
    rdfs:label "Vessel Capacity" ;
    rdfs:comment """A measurable capacity attribute of a vessel, including tonnage values,
    TEU capacity, passenger capacity, or cargo volume.""" .

:GrossTonnage a owl:Class ;
    rdfs:label "Gross Tonnage" ;
    rdfs:comment """A non-linear measure of a vessel's overall internal volume as defined by
    the International Convention on Tonnage Measurement of Ships (1969).

    Expressed as GT and used for regulatory, safety, and manning requirements.""" ;
    rdfs:subClassOf :VesselCapacity .

:NetTonnage a owl:Class ;
    rdfs:label "Net Tonnage" ;
    rdfs:comment """A measure of the useful capacity of a vessel derived from gross tonnage
    by deducting non-cargo spaces, as defined by the 1969 Tonnage Convention.

    Used for port dues and canal toll calculations.""" ;
    rdfs:subClassOf :VesselCapacity .

:DeadweightTonnage a owl:Class ;
    rdfs:label "Deadweight Tonnage" ;
    rdfs:comment """The maximum weight a vessel can carry including cargo, fuel, fresh water,
    ballast, provisions, passengers, and crew, measured in metric tonnes.

    DWT = displacement at summer load line minus lightweight.""" ;
    rdfs:subClassOf :VesselCapacity .

:VesselOperationalStatus a owl:Class ;
    rdfs:label "Vessel Operational Status" ;
    rdfs:comment """The current operational state of a vessel, such as in service, laid up,
    under repair, scrapped, or broken up. Used for fleet management and reporting.""" .

#################################################################
#    Object Properties
#################################################################

:hasVesselType a owl:ObjectProperty ;
    rdfs:label "has vessel type" ;
    rdfs:comment "Associates a vessel with its classification type." ;
    rdfs:domain :Vessel ;
    rdfs:range :VesselType .

:hasFlagState a owl:ObjectProperty ;
    rdfs:label "has flag state" ;
    rdfs:comment "Associates a vessel with the state whose flag it flies." ;
    rdfs:domain :Vessel ;
    rdfs:range :FlagState .

:hasClassSociety a owl:ObjectProperty ;
    rdfs:label "has classification society" ;
    rdfs:comment "Associates a vessel with the classification society responsible for its survey and certification." ;
    rdfs:domain :Vessel ;
    rdfs:range :ClassSociety .

:hasCapacity a owl:ObjectProperty ;
    rdfs:label "has capacity" ;
    rdfs:comment "Associates a vessel with a capacity measurement." ;
    rdfs:domain :Vessel ;
    rdfs:range :VesselCapacity .

:hasOperationalStatus a owl:ObjectProperty ;
    rdfs:label "has operational status" ;
    rdfs:comment "Associates a vessel with its current operational status." ;
    rdfs:domain :Vessel ;
    rdfs:range :VesselOperationalStatus .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Associates a fleet with a vessel belonging to it." ;
    rdfs:domain :Fleet ;
    rdfs:range :Vessel .

:hasIMONumber a owl:ObjectProperty ;
    rdfs:label "has IMO number" ;
    rdfs:comment "Associates a vessel with its IMO number record." ;
    rdfs:domain :Vessel ;
    rdfs:range :IMONumber .

:hasMMSI a owl:ObjectProperty ;
    rdfs:label "has MMSI" ;
    rdfs:comment "Associates a vessel with its Maritime Mobile Service Identity." ;
    rdfs:domain :Vessel ;
    rdfs:range :MMSI .

:hasCallSign a owl:ObjectProperty ;
    rdfs:label "has call sign" ;
    rdfs:comment "Associates a vessel with its radio call sign." ;
    rdfs:domain :Vessel ;
    rdfs:range :CallSign .

#################################################################
#    Datatype Properties
#################################################################

:imoNumber a owl:DatatypeProperty ;
    rdfs:label "IMO number" ;
    rdfs:comment "The seven-digit IMO ship identification number (e.g., '9074729')." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:string .

:mmsiNumber a owl:DatatypeProperty ;
    rdfs:label "MMSI number" ;
    rdfs:comment "The nine-digit Maritime Mobile Service Identity number." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:string .

:callSignValue a owl:DatatypeProperty ;
    rdfs:label "call sign value" ;
    rdfs:comment "The radio call sign string allocated by the flag state." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:string .

:vesselName a owl:DatatypeProperty ;
    rdfs:label "vessel name" ;
    rdfs:comment "The registered name of the vessel." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:string .

:grossTonnageValue a owl:DatatypeProperty ;
    rdfs:label "gross tonnage value" ;
    rdfs:comment "Numeric gross tonnage value as per the 1969 Tonnage Convention." ;
    rdfs:domain :GrossTonnage ;
    rdfs:range xsd:decimal .

:netTonnageValue a owl:DatatypeProperty ;
    rdfs:label "net tonnage value" ;
    rdfs:comment "Numeric net tonnage value as per the 1969 Tonnage Convention." ;
    rdfs:domain :NetTonnage ;
    rdfs:range xsd:decimal .

:deadweightTonnageValue a owl:DatatypeProperty ;
    rdfs:label "deadweight tonnage value" ;
    rdfs:comment "Deadweight tonnage in metric tonnes." ;
    rdfs:domain :DeadweightTonnage ;
    rdfs:range xsd:decimal .

:lengthOverallValue a owl:DatatypeProperty ;
    rdfs:label "length overall value" ;
    rdfs:comment "Length overall of the vessel in metres." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:decimal .

:beamValue a owl:DatatypeProperty ;
    rdfs:label "beam value" ;
    rdfs:comment "Maximum beam (breadth) of the vessel in metres." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:decimal .

:draftValue a owl:DatatypeProperty ;
    rdfs:label "draft value" ;
    rdfs:comment "Current draft of the vessel in metres." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:decimal .

:yearBuilt a owl:DatatypeProperty ;
    rdfs:label "year built" ;
    rdfs:comment "The year in which the vessel was built." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:gYear .

:portOfRegistry a owl:DatatypeProperty ;
    rdfs:label "port of registry" ;
    rdfs:comment "The port where the vessel is registered (home port)." ;
    rdfs:domain :Vessel ;
    rdfs:range xsd:string .
