@prefix : <http://kairos.ai/ont/wco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wco-customs: <http://kairos.ai/ont/wco/customs#> .
@prefix wco-tf: <http://kairos.ai/ont/wco/trade-facilitation#> .
@prefix wco-party: <http://kairos.ai/ont/wco/party#> .
@prefix wco-loc: <http://kairos.ai/ont/wco/locations#> .
@prefix wco-doc: <http://kairos.ai/ont/wco/documents#> .

# Ontology Metadata
: a owl:Ontology ;
    dcterms:title "Kairos WCO Customs Ontology" ;
    dcterms:description """World Customs Organization (WCO) ontology for international customs procedures and trade facilitation.

    This ontology provides a semantic framework for customs operations, covering:
    - Customs declarations and filing procedures
    - Trade facilitation certificates and permits
    - Party roles in customs processes
    - Customs locations and controlled areas
    - Customs and trade documents

    Fully aligned with WCO Data Model 3.0 and eFTI Regulation (EU) 2020/1056.""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:modified "2026-05-16"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dcterms:source "WCO Data Model 3.0, eFTI Regulation (EU) 2020/1056" ;
    owl:imports <http://kairos.ai/ont/wco/customs#> ,
                <http://kairos.ai/ont/wco/trade-facilitation#> ,
                <http://kairos.ai/ont/wco/party#> ,
                <http://kairos.ai/ont/wco/locations#> ,
                <http://kairos.ai/ont/wco/documents#> .
