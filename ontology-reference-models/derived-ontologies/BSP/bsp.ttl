@prefix : <http://kairos.ai/ont/bsp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
: a owl:Ontology ;
    dcterms:title "Kairos ISO Buy-Ship-Pay Reference Data Model Ontology" ;
    dcterms:description """ISO Buy-Ship-Pay Reference Data Model (ISO 20197-1:2024) ontology for international trade lifecycle.
    
    This ontology provides a comprehensive semantic framework for the complete trade transaction lifecycle, covering:
    - Buy: Purchase orders, quotations, contracts, and commercial agreements
    - Ship: Transport execution, shipment tracking, and logistics operations
    - Pay: Invoicing, payment terms, settlement, and trade finance
    - Cross-cutting: Parties, locations, documents, and regulatory compliance
    - Trade facilitation: Customs, certificates, licenses, and cross-border processes
    
    Fully aligned with ISO 20197-1:2024 standard for global supply chain and trade interoperability.
    
    This root ontology imports all six domain modules:
    - Party: Trade party roles and contact information
    - Commercial: Commercial transactions, shipments, and business events
    - Financial: Invoicing, payment, and trade finance instruments
    - Documents: Trade, transport, and regulatory documents
    - Compliance: Regulatory requirements, tariffs, sanctions, and trade agreements
    - Reference Data: Locations, measurements, and code lists""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-05-16"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dcterms:source "ISO 20197-1:2024 Buy-Ship-Pay Reference Data Model" ;
    dcterms:references "UN/CEFACT Multi-Modal Transport Reference Data Model" ;
    owl:imports <http://kairos.ai/ont/bsp/party> ;
    owl:imports <http://kairos.ai/ont/bsp/commercial> ;
    owl:imports <http://kairos.ai/ont/bsp/financial> ;
    owl:imports <http://kairos.ai/ont/bsp/documents> ;
    owl:imports <http://kairos.ai/ont/bsp/compliance> ;
    owl:imports <http://kairos.ai/ont/bsp/reference-data> .
