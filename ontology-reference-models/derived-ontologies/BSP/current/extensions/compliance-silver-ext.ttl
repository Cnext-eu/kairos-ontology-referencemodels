@prefix : <https://www.kairosflow.ai/ont/bsp/compliance/silver-ext#> .
@prefix bsp-comp: <https://www.kairosflow.ai/ont/bsp/compliance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — BSP Compliance Domain
# =============================================================================

: a owl:Ontology ;
    dcterms:title "BSP Compliance — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the BSP Compliance domain ontology. Controls DDL generation, SCD behaviour, and table structure." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-19"^^xsd:date ;
    owl:versionInfo "1.2.0" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/compliance#> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations
# =============================================================================

bsp-comp:RegulatoryRequirement
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# TariffClassification — reference/code-list table (HS codes, tariff codes).
# SCD Type 1 (overwrite) with ref_ prefix.
bsp-comp:TariffClassification
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "hsCode" .

bsp-comp:DutyTax
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-comp:TradeAgreement
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-comp:CustomsEvent
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# Object Property Annotations (FK declarations)
# =============================================================================

# DutyTax references TariffClassification (many-to-one)
bsp-comp:hasTariffClassification
    kairos-ext:silverForeignKey "true"^^xsd:boolean .
