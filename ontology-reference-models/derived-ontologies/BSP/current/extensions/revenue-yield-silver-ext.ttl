@prefix : <https://www.kairosflow.ai/ont/bsp/revenue-yield/silver-ext#> .
@prefix bsp-rev: <https://www.kairosflow.ai/ont/bsp/revenue-yield#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — BSP Revenue & Yield Domain
# =============================================================================

<https://www.kairosflow.ai/ont/bsp/revenue-yield/silver-ext> a owl:Ontology ;
    dcterms:title "BSP Revenue & Yield — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the BSP Revenue & Yield domain ontology." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-22"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/revenue-yield> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations
# =============================================================================

bsp-rev:RevenueItem
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:inheritanceStrategy "discriminator" ;
    kairos-ext:discriminatorColumn "revenue_category" ;
    kairos-ext:naturalKey "revenueCategory, period" .

bsp-rev:FreightRevenue
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:SurchargeRevenue
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:AncillaryRevenue
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:RevenuePerUnit
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:LoadFactor
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:CapacityUtilization
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:RateCard
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:inheritanceStrategy "discriminator" ;
    kairos-ext:discriminatorColumn "rate_card_type" ;
    kairos-ext:naturalKey "validFrom, rateBasis" .

bsp-rev:SpotRate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:ContractRate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:ContributionMargin
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-rev:ProfitabilityScope
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:naturalKey "scopeType, scopeIdentifier" .

bsp-rev:YieldAnalysis
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# FK Annotations
# =============================================================================

bsp-rev:hasContributionMargin
    kairos-ext:silverForeignKeyOn bsp-rev:ContributionMargin .

bsp-rev:hasYieldAnalysis
    kairos-ext:silverForeignKeyOn bsp-rev:YieldAnalysis .

bsp-rev:measuredFor
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-rev:appliesRateCard
    kairos-ext:silverForeignKey "true"^^xsd:boolean .
