@prefix : <https://www.kairosflow.ai/ont/bsp/party/silver-ext#> .
@prefix bsp-party: <https://www.kairosflow.ai/ont/bsp/party#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — BSP Party Domain
# =============================================================================

<https://www.kairosflow.ai/ont/bsp/party/silver-ext> a owl:Ontology ;
    dcterms:title "BSP Party — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the BSP Party domain ontology. Controls DDL generation, SCD behaviour, and table structure." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-19"^^xsd:date ;
    owl:versionInfo "1.2.0" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/party> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations
# =============================================================================

# TradeParty — root of the party hierarchy.
# All 11 subtypes are flattened into a single table using discriminator strategy.
bsp-party:TradeParty
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:inheritanceStrategy "discriminator" ;
    kairos-ext:discriminatorColumn "party_type" ;
    kairos-ext:naturalKey "partyIdentifier" ;
    kairos-ext:clusterBy "is_current, party_type" .

# Subtypes — flattened into TradeParty per S3 (silver always flattens).
# Annotations preserved for documentation and gold-layer use.

bsp-party:Buyer
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Seller
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Shipper
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Consignee
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Carrier
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:FreightForwarder
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:CustomsBroker
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Bank
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Manufacturer
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:Supplier
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-party:NotifyParty
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# Object Property Annotations (FK declarations)
# =============================================================================

# hasBuyer, hasSeller, hasShipper, etc. are many-to-one from the referencing
# entity to TradeParty. FK lives on the referencing table (default direction).
bsp-party:hasBuyer
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-party:hasSeller
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-party:hasShipper
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-party:hasConsignee
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-party:hasCarrier
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-party:hasManufacturer
    kairos-ext:silverForeignKey "true"^^xsd:boolean .
