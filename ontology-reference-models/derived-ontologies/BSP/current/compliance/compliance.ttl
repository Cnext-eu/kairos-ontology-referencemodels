@prefix : <https://www.kairosflow.ai/ont/bsp/compliance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix comm: <https://www.kairosflow.ai/ont/bsp/commercial#> .
@prefix refdata: <https://www.kairosflow.ai/ont/bsp/reference-data#> .

# Ontology Metadata
<https://www.kairosflow.ai/ont/bsp/compliance> a owl:Ontology ;
    dcterms:title "Kairos BSP Compliance Domain Ontology" ;
    dcterms:description """Regulatory and compliance domain of the Buy-Ship-Pay Reference Data Model.

    This module defines regulatory and compliance classes covering:
    - Regulatory Requirements: Legal and regulatory obligations for trade
    - Tariff Classification: Harmonized System (HS) code classification
    - Duties and Taxes: Customs duties, VAT, excise
    - Trade Agreements: Buyer-seller contractual terms
    - Events: Customs clearance lifecycle events""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-05-22"^^xsd:date ;
    owl:versionInfo "2.1.0" ;
    dcterms:source "UN/CEFACT Buy-Ship-Pay Reference Data Model (BSP-RDM v1.0)" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/> .

#################################################################
#    Regulatory and Compliance Classes
#################################################################

:RegulatoryRequirement a owl:Class ;
    rdfs:label "Regulatory Requirement" ;
    rdfs:comment """A legal or regulatory obligation for cross-border trade.
    
    UN/CEFACT BSP: Maps to RegulatoryProcedure — formal steps to satisfy
    a cross-border regulation, law or convention.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/RegulatoryProcedure> .

:TariffClassification a owl:Class ;
    rdfs:label "Tariff Classification" ;
    rdfs:comment """The classification of goods for customs purposes using the Harmonized System.
    
    UN/CEFACT BSP: Maps to Classification and CustomsValuation.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/Classification> ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/wco/customs#TariffClassification> .

:DutyTax a owl:Class ;
    rdfs:label "Duty/Tax" ;
    rdfs:comment """A customs duty or tax on imported/exported goods.
    
    UN/CEFACT BSP: Maps to TradeTax — a trade related fiscal levy or duty.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/TradeTax> ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/wco/customs#DutyCalculation> .

:TradeAgreement a owl:Class ;
    rdfs:label "Trade Agreement" ;
    rdfs:comment """The contractual terms agreed between buyer and seller for a trade transaction.
    
    UN/CEFACT BSP: Maps to HeaderTradeAgreement — covers Incoterms, pricing,
    delivery terms, and conditions between trading parties.""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/HeaderTradeAgreement> ;
    rdfs:seeAlso <https://www.kairosflow.ai/ont/wco/trade-facilitation#TradeAgreementReference> .

#################################################################
#    Event Classes
#################################################################

:CustomsEvent a owl:Class ;
    rdfs:label "Customs Event" ;
    rdfs:comment """An event in the customs clearance process.
    
    UN/CEFACT BSP: A SupplyChainEvent occurring during regulatory procedures
    (declaration submitted, inspection, clearance granted).""" ;
    rdfs:seeAlso <https://vocabulary.uncefact.org/SupplyChainEvent> .

#################################################################
#    Object Properties
#################################################################

:hasTariffClassification a owl:ObjectProperty ;
    rdfs:label "has tariff classification" ;
    rdfs:comment "Relates product to tariff classification." ;
    rdfs:domain comm:Product ;
    rdfs:range :TariffClassification .

:hasCountryOfOrigin a owl:ObjectProperty ;
    rdfs:label "has country of origin" ;
    rdfs:comment "Identifies country where goods were produced." ;
    rdfs:domain comm:Product ;
    rdfs:range refdata:Country .

#################################################################
#    Datatype Properties
#################################################################

:hsCode a owl:DatatypeProperty ;
    rdfs:label "HS code" ;
    rdfs:comment "Harmonized System tariff classification code." ;
    rdfs:domain :TariffClassification ;
    rdfs:range xsd:string .

:dutyRate a owl:DatatypeProperty ;
    rdfs:label "duty rate" ;
    rdfs:comment "Customs duty percentage rate." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:decimal .

:dutyAmount a owl:DatatypeProperty ;
    rdfs:label "duty amount" ;
    rdfs:comment "Amount of customs duty owed." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:decimal .

#################################################################
#    Datatype Properties — Compliance Enrichment (v1.3.0)
#################################################################

:procedureType a owl:DatatypeProperty ;
    rdfs:label "procedure type" ;
    rdfs:comment "Type of regulatory procedure (IMPORT, EXPORT, TRANSIT, TEMPORARY_ADMISSION, INWARD_PROCESSING, OUTWARD_PROCESSING)." ;
    rdfs:domain :RegulatoryRequirement ;
    rdfs:range xsd:string .

:governmentAction a owl:DatatypeProperty ;
    rdfs:label "government action" ;
    rdfs:comment "Action taken by the government authority (EXAMINATION, RELEASE, SEIZURE, RE_EXPORT, DETENTION)." ;
    rdfs:domain :RegulatoryRequirement ;
    rdfs:range xsd:string .

:regulatoryAuthority a owl:DatatypeProperty ;
    rdfs:label "regulatory authority" ;
    rdfs:comment "Name of the regulatory authority imposing the requirement." ;
    rdfs:domain :RegulatoryRequirement ;
    rdfs:range xsd:string .

:agreementName a owl:DatatypeProperty ;
    rdfs:label "agreement name" ;
    rdfs:comment "Name of the trade agreement (e.g., EU_GSP, CPTPP, RCEP, USMCA, EU_UK_TCA)." ;
    rdfs:domain :TradeAgreement ;
    rdfs:range xsd:string .

:preferentialRate a owl:DatatypeProperty ;
    rdfs:label "preferential rate" ;
    rdfs:comment "The preferential duty rate applicable under the trade agreement, as a percentage." ;
    rdfs:domain :TradeAgreement ;
    rdfs:range xsd:decimal .

:agreementEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "agreement effective date" ;
    rdfs:comment "Date when the trade agreement came into force." ;
    rdfs:domain :TradeAgreement ;
    rdfs:range xsd:date .

:hsDescription a owl:DatatypeProperty ;
    rdfs:label "HS description" ;
    rdfs:comment "Text description of the HS code classification for the goods." ;
    rdfs:domain :TariffClassification ;
    rdfs:range xsd:string .

:hsChapter a owl:DatatypeProperty ;
    rdfs:label "HS chapter" ;
    rdfs:comment "HS chapter number (2-digit heading, e.g., '87' for vehicles)." ;
    rdfs:domain :TariffClassification ;
    rdfs:range xsd:string .

:dutyType a owl:DatatypeProperty ;
    rdfs:label "duty type" ;
    rdfs:comment "Type of duty or tax (AD_VALOREM, SPECIFIC, COMPOUND, ANTI_DUMPING, COUNTERVAILING, EXCISE, VAT)." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:string .

:dutyCurrency a owl:DatatypeProperty ;
    rdfs:label "duty currency" ;
    rdfs:comment "ISO 4217 currency code for the duty amount." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:string .
