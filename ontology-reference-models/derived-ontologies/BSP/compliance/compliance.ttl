@prefix : <http://kairos.ai/ont/bsp/compliance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Ontology Metadata
: a owl:Ontology ;
    dcterms:title "Kairos BSP Compliance Domain Ontology" ;
    dcterms:description """Regulatory and compliance domain of the ISO Buy-Ship-Pay Reference Data Model (ISO 20197-1:2024).

    This module defines regulatory and compliance classes covering:
    - Regulatory Requirements: Legal and regulatory obligations for trade
    - Tariff Classification: Harmonized System (HS) code classification
    - Duties and Taxes: Customs duties, VAT, excise
    - Trade Sanctions: Embargoes and export controls
    - Trade Agreements: FTAs and preferential arrangements
    - Rules of Origin: Criteria for economic nationality of goods
    - Events: Customs clearance lifecycle events""" ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-01-06"^^xsd:date ;
    dcterms:modified "2026-05-16"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    dcterms:source "ISO 20197-1:2024 Buy-Ship-Pay Reference Data Model" .

#################################################################
#    Regulatory and Compliance Classes
#################################################################

:RegulatoryRequirement a owl:Class ;
    rdfs:label "Regulatory Requirement" ;
    rdfs:comment """A legal or regulatory obligation.
    
    ISO BSP: Customs, trade compliance, licensing.""" .

:TariffClassification a owl:Class ;
    rdfs:label "Tariff Classification" ;
    rdfs:comment """The classification of goods for customs purposes.
    
    ISO BSP: Harmonized System (HS) code.""" .

:DutyTax a owl:Class ;
    rdfs:label "Duty/Tax" ;
    rdfs:comment """A customs duty or tax on imported/exported goods.
    
    ISO BSP: Import duty, VAT, excise tax.""" .

:TradeSanction a owl:Class ;
    rdfs:label "Trade Sanction" ;
    rdfs:comment """A restriction on trade with specific countries or parties.
    
    ISO BSP: Embargoes, export controls.""" .

:TradeAgreement a owl:Class ;
    rdfs:label "Trade Agreement" ;
    rdfs:comment """An agreement between countries on trade terms.
    
    ISO BSP: FTA, preferential trade arrangement.""" .

:RuleOfOrigin a owl:Class ;
    rdfs:label "Rule of Origin" ;
    rdfs:comment """Criteria determining economic nationality of goods.
    
    ISO BSP: For preferential tariff treatment.""" .

#################################################################
#    Event Classes
#################################################################

:CustomsEvent a owl:Class ;
    rdfs:label "Customs Event" ;
    rdfs:comment """An event in customs clearance process.
    
    ISO BSP: Declaration submitted, inspection, clearance.""" .

#################################################################
#    Object Properties
#################################################################

:hasTariffClassification a owl:ObjectProperty ;
    rdfs:label "has tariff classification" ;
    rdfs:comment "Relates product to tariff classification." ;
    rdfs:range :TariffClassification .

:hasCountryOfOrigin a owl:ObjectProperty ;
    rdfs:label "has country of origin" ;
    rdfs:comment "Identifies country where goods were produced." .

#################################################################
#    Datatype Properties
#################################################################

:hsCode a owl:DatatypeProperty ;
    rdfs:label "HS code" ;
    rdfs:comment "Harmonized System tariff classification code." ;
    rdfs:range xsd:string .

:dutyRate a owl:DatatypeProperty ;
    rdfs:label "duty rate" ;
    rdfs:comment "Customs duty percentage rate." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:decimal .

:dutyAmount a owl:DatatypeProperty ;
    rdfs:label "duty amount" ;
    rdfs:comment "Amount of customs duty owed." ;
    rdfs:domain :DutyTax ;
    rdfs:range xsd:decimal .
