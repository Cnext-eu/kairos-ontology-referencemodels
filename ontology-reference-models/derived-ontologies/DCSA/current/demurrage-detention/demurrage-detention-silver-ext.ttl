@prefix : <https://www.kairosflow.ai/ont/dcsa/demurrage-detention/silver-ext#> .
@prefix dcsa-dd: <https://www.kairosflow.ai/ont/dcsa/demurrage-detention#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — DCSA Demurrage & Detention Domain
# =============================================================================

<https://www.kairosflow.ai/ont/dcsa/demurrage-detention/silver-ext> a owl:Ontology ;
    dcterms:title "DCSA Demurrage & Detention — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the DCSA Demurrage & Detention domain ontology." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-22"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:imports <https://www.kairosflow.ai/ont/dcsa/demurrage-detention> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations
# =============================================================================

dcsa-dd:DemurrageCharge
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:naturalKey "chargeStartDate, portCode, equipmentType" .

dcsa-dd:DetentionCharge
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:naturalKey "chargeStartDate, portCode, equipmentType" .

dcsa-dd:CombinedDemurrageDetention
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

dcsa-dd:StorageCharge
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

dcsa-dd:FreeTimeAllowance
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "freeTimeType, portCode, equipmentType" .

dcsa-dd:PerDiemRate
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean .

dcsa-dd:RateTier
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "tierStartDay, tierEndDay" .

dcsa-dd:DemurrageDetentionTariff
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "validFrom, portCode" .

dcsa-dd:DemurrageEvent
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

dcsa-dd:DetentionEvent
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

dcsa-dd:DisputeRecord
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

dcsa-dd:Waiver
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# FK Annotations
# =============================================================================

dcsa-dd:appliesTariff
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

dcsa-dd:hasFreeTimeAllowance
    kairos-ext:silverForeignKeyOn dcsa-dd:FreeTimeAllowance .

dcsa-dd:hasPerDiemRate
    kairos-ext:silverForeignKeyOn dcsa-dd:PerDiemRate .

dcsa-dd:hasRateTier
    kairos-ext:silverForeignKeyOn dcsa-dd:RateTier .

dcsa-dd:hasDispute
    kairos-ext:silverForeignKeyOn dcsa-dd:DisputeRecord .

dcsa-dd:hasWaiver
    kairos-ext:silverForeignKeyOn dcsa-dd:Waiver .
