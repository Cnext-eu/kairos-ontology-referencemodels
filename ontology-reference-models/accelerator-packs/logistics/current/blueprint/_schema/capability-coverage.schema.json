{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kairosflow.ai/schema/logistics/capability-coverage.schema.json",
  "title": "Logistics capability coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "accelerator_version", "capabilities"],
  "properties": {
    "format_version": {"const": "1.0"},
    "accelerator_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "concept_ids",
          "extension_points",
          "evidence",
          "confidence",
          "maturity"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "status": {"enum": ["supported", "optional", "deferred", "out_of_scope"]},
          "concept_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "extension_points": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "maturity": {"enum": ["experimental", "preview", "stable"]}
        }
      }
    }
  }
}
