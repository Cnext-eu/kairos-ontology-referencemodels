{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kairosflow.ai/schema/logistics/overlap-register.schema.json",
  "title": "Logistics overlap register",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "accelerator_version", "entries"],
  "properties": {
    "format_version": {"const": "1.0"},
    "accelerator_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "concept_id",
          "class_uris",
          "disposition",
          "rationale",
          "evidence",
          "confidence",
          "maturity",
          "first_slice"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "concept_id": {"type": "string", "minLength": 1},
          "class_uris": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "disposition": {
            "enum": [
              "canonical_authority",
              "specialisation",
              "contextual_role",
              "distinct_grain",
              "cross_standard_alignment",
              "deferred",
              "reference_model_gap",
              "unresolved"
            ]
          },
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "maturity": {"enum": ["experimental", "preview", "stable"]},
          "first_slice": {"type": "boolean"}
        }
      }
    }
  }
}
