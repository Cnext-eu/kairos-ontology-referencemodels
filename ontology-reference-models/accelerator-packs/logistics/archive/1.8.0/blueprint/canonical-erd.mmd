    Party["Party identity<br/>UNRESOLVED"]:::unresolved
    PartyRole["Party role assignment<br/>GAP / INVESTIGATE"]:::gap
    Location["Location identity<br/>UNRESOLVED"]:::unresolved
    LocationRole["Location role assignment<br/>GAP / INVESTIGATE"]:::gap
    Booking["Booking<br/>UNRESOLVED"]:::unresolved
    Shipment["Shipment<br/>UNRESOLVED"]:::unresolved
    Consignment["Consignment<br/>UNRESOLVED"]:::unresolved
    Item["Consignment item<br/>UNRESOLVED"]:::unresolved
    Request["Equipment request<br/>UNRESOLVED"]:::unresolved
    Allocation["Equipment utilisation<br/>UNRESOLVED"]:::unresolved
    Asset["Equipment asset<br/>UNRESOLVED"]:::unresolved
    Journey["Container journey<br/>UNRESOLVED"]:::unresolved
    Route["Transport route<br/>UNRESOLVED"]:::unresolved
    Leg["Transport leg<br/>UNRESOLVED"]:::unresolved
    Movement["Transport movement<br/>UNRESOLVED"]:::unresolved
