@prefix : <https://www.kairosflow.ai/ont/bsp/documents/silver-ext#> .
@prefix bsp-doc: <https://www.kairosflow.ai/ont/bsp/documents#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — BSP Documents Domain
# =============================================================================

<https://www.kairosflow.ai/ont/bsp/documents/silver-ext> a owl:Ontology ;
    dcterms:title "BSP Documents — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the BSP Documents domain ontology. Controls DDL generation, SCD behaviour, and table structure." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-19"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/documents> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations — Document Hierarchy
# =============================================================================

# Document — root class. All 14 document subtypes are flattened into a single
# table using discriminator strategy.
bsp-doc:Document
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:inheritanceStrategy "discriminator" ;
    kairos-ext:discriminatorColumn "document_type_discriminator" ;
    kairos-ext:naturalKey "documentNumber" ;
    kairos-ext:clusterBy "is_current, document_type_discriminator" .

# --- Transport Documents (intermediate + leaf subtypes) ---

bsp-doc:TransportDocument
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:BillOfLading
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:AirWaybill
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# --- Other Document Subtypes ---

bsp-doc:PackingList
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:CertificateOfOrigin
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:CustomsDeclaration
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:ImportLicense
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:ExportLicense
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:InspectionCertificate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:PhytosanitaryCertificate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:HealthCertificate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:InsuranceCertificate
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:DeliveryNote
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-doc:ReceiptAdvice
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# Class Annotations — Document Event
# =============================================================================

bsp-doc:DocumentEvent
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

# =============================================================================
# Object Property Annotations (FK declarations)
# =============================================================================

# hasDocument — many-to-one from referencing entity to Document
bsp-doc:hasDocument
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

# hasTransportDocument — many-to-one from referencing entity to TransportDocument
bsp-doc:hasTransportDocument
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

# hasCustomsDeclaration — many-to-one from referencing entity to CustomsDeclaration
bsp-doc:hasCustomsDeclaration
    kairos-ext:silverForeignKey "true"^^xsd:boolean .
