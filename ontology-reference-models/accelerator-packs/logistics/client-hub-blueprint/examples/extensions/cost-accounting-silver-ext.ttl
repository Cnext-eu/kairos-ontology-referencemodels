@prefix : <https://www.kairosflow.ai/ont/bsp/cost-accounting/silver-ext#> .
@prefix bsp-cost: <https://www.kairosflow.ai/ont/bsp/cost-accounting#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kairos-ext: <https://kairos.cnext.eu/ext#> .

# =============================================================================
# Silver Extension — BSP Cost Accounting Domain
# =============================================================================

<https://www.kairosflow.ai/ont/bsp/cost-accounting/silver-ext> a owl:Ontology ;
    dcterms:title "BSP Cost Accounting — Silver Extension" ;
    dcterms:description "Silver-layer projection annotations for the BSP Cost Accounting domain ontology." ;
    dcterms:creator "Kairos Ontology Team" ;
    dcterms:created "2026-05-22"^^xsd:date ;
    owl:versionInfo "1.3.0" ;
    owl:imports <https://www.kairosflow.ai/ont/bsp/cost-accounting> ;
    kairos-ext:namingConvention "camel-to-snake" ;
    kairos-ext:includeNaturalKeyColumn "true"^^xsd:boolean ;
    kairos-ext:inlineRefThreshold "3"^^xsd:integer .

# =============================================================================
# Class Annotations
# =============================================================================

bsp-cost:CostAllocation
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-cost:CostCenter
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "costCenterCode" .

bsp-cost:TransportCostItem
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:naturalKey "costType, period" .

bsp-cost:CostPerUnit
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-cost:CostToServe
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-cost:BudgetItem
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean ;
    kairos-ext:naturalKey "period, costCenterCode" .

bsp-cost:CostVariance
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-cost:OverheadAllocation
    kairos-ext:scdType "2" ;
    kairos-ext:isReferenceData "false"^^xsd:boolean .

bsp-cost:AllocationBasis
    kairos-ext:scdType "1" ;
    kairos-ext:isReferenceData "true"^^xsd:boolean ;
    kairos-ext:naturalKey "allocationBasisType" .

# =============================================================================
# FK Annotations
# =============================================================================

bsp-cost:hasCostCenter
    kairos-ext:silverForeignKey "true"^^xsd:boolean .

bsp-cost:hasCostItem
    kairos-ext:silverForeignKeyOn bsp-cost:TransportCostItem .

bsp-cost:hasBudget
    kairos-ext:silverForeignKeyOn bsp-cost:BudgetItem .

bsp-cost:hasVariance
    kairos-ext:silverForeignKeyOn bsp-cost:CostVariance .

bsp-cost:usesAllocationBasis
    kairos-ext:silverForeignKey "true"^^xsd:boolean .
